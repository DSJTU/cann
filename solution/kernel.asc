#include "kernel_operator.h"
#include <cstdint>
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include <stdexcept>
#include <exception>
#include <map>
#include <memory>
#include <mutex>
#include <vector>

namespace bmmms {
constexpr uint32_t kKTile = 128;
constexpr uint32_t kSlot = 8;
__aicore__ inline uint32_t Min(uint32_t a, uint32_t b) { return a < b ? a : b; }
template <AscendC::HardEvent event> __aicore__ inline void Fence(AscendC::TPipe &pipe) {
    const auto id = pipe.FetchEventID(event);
    AscendC::SetFlag<event>(id);
    AscendC::WaitFlag<event>(id);
}

template <typename T, bool transA, bool transB>
__schedmode__(1) __global__ __mix__(0, 1) void Baseline(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint32_t batch,
                                                        uint32_t m, uint32_t n, uint32_t k, uint32_t groups) {
    const uint32_t kNTile = n <= 16 ? 16 : (transB ? 64 : 32);
    const bool cacheB = k <= kKTile && m >= 16 && n >= 16;
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<T> a, b;
    AscendC::GlobalTensor<float> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1), batch * m * k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2), batch * n * k);
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batch);
    AscendC::TBuf<AscendC::TPosition::VECIN> rawABuf, rawBBuf;
    AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> aCastBuf, bCastBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> queryBuf, docBuf, productBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> aOffsetsBuf, bOffsetsBuf, tailOffsetsBuf, maxOffsetsBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sumsBuf, partBuf, highPartBuf, correctionBuf, rowMaxBuf;

    pipe.InitBuffer(rawABuf, kKTile * 16 * sizeof(T));
    pipe.InitBuffer(rawBBuf, kNTile * kKTile * sizeof(T));
    pipe.InitBuffer(aCastBuf, kKTile * 16 * sizeof(float));
    pipe.InitBuffer(bCastBuf, kNTile * kKTile * sizeof(float));
    pipe.InitBuffer(queryBuf, ((k + 15) / 16 * 16) * sizeof(float));
    pipe.InitBuffer(docBuf, transB ? 32 : kNTile * kKTile * sizeof(float));
    pipe.InitBuffer(productBuf, kNTile * kKTile * sizeof(float));
    pipe.InitBuffer(aOffsetsBuf, kKTile * sizeof(uint32_t));
    pipe.InitBuffer(maxOffsetsBuf, kNTile * sizeof(uint32_t));
    pipe.InitBuffer(bOffsetsBuf, transB ? 32 : kNTile * kKTile * sizeof(uint32_t));
    pipe.InitBuffer(tailOffsetsBuf, transB ? 32 : kNTile * kKTile * sizeof(uint32_t));
    pipe.InitBuffer(sumsBuf, kNTile * kSlot * sizeof(float));
    pipe.InitBuffer(partBuf, kNTile * kSlot * sizeof(float));
    pipe.InitBuffer(highPartBuf, kNTile * kSlot * sizeof(float));
    pipe.InitBuffer(correctionBuf, kNTile * kSlot * sizeof(float));
    pipe.InitBuffer(rowMaxBuf, cacheB ? ((m + 7) / 8 * 8) * sizeof(float) : 32);
    pipe.InitBuffer(outBuf, 32);
    auto rawA = rawABuf.Get<T>();
    auto rawB = rawBBuf.Get<T>();
    auto castA = aCastBuf.Get<float>();
    auto castB = bCastBuf.Get<float>();
    auto query = queryBuf.Get<float>();
    auto docs = docBuf.Get<float>();
    auto product = productBuf.Get<float>();
    auto aOffsets = aOffsetsBuf.Get<uint32_t>();
    auto maxOffsets = maxOffsetsBuf.Get<uint32_t>();
    auto bOffsets = bOffsetsBuf.Get<uint32_t>();
    auto tailOffsets = tailOffsetsBuf.Get<uint32_t>();
    auto sums = sumsBuf.Get<float>();
    auto parts = partBuf.Get<float>();
    auto highParts = highPartBuf.Get<float>();
    auto corrections = correctionBuf.Get<float>();
    auto result = outBuf.Get<float>();
    auto rowMaxima = rowMaxBuf.Get<float>();
    const uint32_t tailColumns = n % kNTile;
    if (transA || (!transB && kNTile > 16 && tailColumns > 0 && tailColumns <= 16)) {
        for (uint32_t i = 0; i < Min(kKTile, k); ++i)
            aOffsets.SetValue(i, i * 16 * sizeof(float));
    }
    const uint32_t maxColumns = Min(kNTile, n);
    if (n > 8) {
        for (uint32_t i = 0; i < maxColumns; ++i)
            maxOffsets.SetValue(i, i * kSlot * sizeof(float));
    }
    const uint32_t tailK = k % kKTile;
    if (!transB) {
        for (uint32_t col = 0; col < maxColumns; ++col) {
            if (k >= kKTile) {
                for (uint32_t kk = 0; kk < kKTile; ++kk)
                    bOffsets.SetValue(col * kKTile + kk, (kk * kNTile + col) * sizeof(float));
            }
            for (uint32_t kk = 0; kk < tailK; ++kk)
                tailOffsets.SetValue(col * tailK + kk, (kk * kNTile + col) * sizeof(float));
        }
    }
    Fence<AscendC::HardEvent::S_V>(pipe);

    AscendC::Duplicate(parts, 0.0f, kNTile * kSlot);
    AscendC::Duplicate(highParts, 0.0f, kNTile * kSlot);
    AscendC::PipeBarrier<PIPE_V>();

    for (uint32_t task = AscendC::GetBlockIdx(); task < batch * groups; task += AscendC::GetBlockNum()) {
        const uint32_t bi = task / groups;
        const uint32_t group = task % groups;
        const uint32_t firstRow = group * m / groups;
        const uint32_t lastRow = (group + 1) * m / groups;
        float batchSum = 0.0f, sumCorrection = 0.0f;
        if (cacheB) {
            for (uint32_t n0 = 0; n0 < n; n0 += kNTile) {
                const uint32_t columns = Min(kNTile, n - n0);
                const uint32_t k0 = 0;
                const uint32_t count = Min(kKTile, k - k0);
                const uint32_t pitch = (count + 15) / 16 * 16;
                if (transB) {
                    AscendC::DataCopyExtParams cp = {uint16_t(columns), count * 2, (k - count) * 2, 0, 0};
                    AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(pitch - count), 0};
                    AscendC::DataCopyPad(rawB, b[bi * n * k + n0 * k + k0], cp, pad);
                    Fence<AscendC::HardEvent::MTE2_V>(pipe);
                    AscendC::Cast(castB, rawB, AscendC::RoundMode::CAST_NONE, columns * pitch);
                    AscendC::PipeBarrier<PIPE_V>();
                } else {
                    const uint32_t bPitch = (columns + 15) / 16 * 16;
                    AscendC::DataCopyExtParams cp = {uint16_t(count), columns * 2, (n - columns) * 2, 0, 0};
                    AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(bPitch - columns), 0};
                    AscendC::DataCopyPad(rawB, b[bi * n * k + k0 * n + n0], cp, pad);
                    Fence<AscendC::HardEvent::MTE2_V>(pipe);
                    AscendC::Cast(castB, rawB, AscendC::RoundMode::CAST_NONE, count * bPitch);
                    AscendC::PipeBarrier<PIPE_V>();
                    if (bPitch == kNTile) {
                        const auto offsets = count == kKTile ? bOffsets : tailOffsets;
                        AscendC::Gather(docs, castB, offsets, 0, columns * count);
                    } else {
                        for (uint32_t col = 0; col < columns; ++col)
                            AscendC::Gather(docs[col * count], castB, aOffsets, col * sizeof(float), count);
                    }
                    AscendC::PipeBarrier<PIPE_V>();
                }
                for (uint32_t row0 = firstRow; row0 < lastRow; row0 += 16) {
                    const uint32_t rows = Min(16, lastRow - row0);
                    const uint32_t aPitch = (k + 15) / 16 * 16;
                    if (transA) {
                        AscendC::DataCopyExtParams cp = {uint16_t(k), rows * 2, (m - rows) * 2, 0, 0};
                        AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(16 - rows), 0};
                        AscendC::DataCopyPad(rawA, a[bi * m * k + row0], cp, pad);
                        Fence<AscendC::HardEvent::MTE2_V>(pipe);
                        AscendC::Cast(castA, rawA, AscendC::RoundMode::CAST_NONE, k * 16);
                    } else {
                        AscendC::DataCopyExtParams cp = {uint16_t(rows), k * 2, 0, 0, 0};
                        AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(aPitch - k), 0};
                        AscendC::DataCopyPad(rawA, a[bi * m * k + row0 * k], cp, pad);
                        Fence<AscendC::HardEvent::MTE2_V>(pipe);
                        AscendC::Cast(castA, rawA, AscendC::RoundMode::CAST_NONE, rows * aPitch);
                    }
                    AscendC::PipeBarrier<PIPE_V>();
                    for (uint32_t localRow = 0; localRow < rows; ++localRow) {
                        const uint32_t row = row0 + localRow;
                        if (transA)
                            AscendC::Gather(query, castA, aOffsets, localRow * sizeof(float), k);
                        else
                            AscendC::DataCopy(query, castA[localRow * aPitch], k);
                        AscendC::PipeBarrier<PIPE_ALL>();
                        float rowMax = n0 == 0 ? 0.0f : rowMaxima.GetValue(row - firstRow);
                        bool first = n0 == 0;
                        AscendC::Duplicate(sums, 0.0f, kNTile * kSlot);
                        AscendC::PipeBarrier<PIPE_V>();
                        const auto doc = transB ? castB : docs;
                        const uint32_t docPitch = transB ? pitch : count;
                        const AscendC::BinaryRepeatParams rp = {
                            1, 1, 1, uint8_t(kKTile / kSlot), uint8_t(docPitch / kSlot), 0};

                        for (uint32_t kk = 0; kk < count; kk += 64) {
                            AscendC::Mul(product[kk], doc[kk], query[k0 + kk], uint64_t(Min(64, count - kk)),
                                         uint8_t(columns), rp);
                        }
                        AscendC::PipeBarrier<PIPE_V>();

                        AscendC::WholeReduceSum(parts, product, int32_t(Min(64, count)), int32_t(columns),
                                                kSlot, 1, kKTile / kSlot);
                        if (count > 64)
                            AscendC::WholeReduceSum(highParts, product[64], int32_t(count - 64),
                                                    int32_t(columns), kSlot, 1, kKTile / kSlot);
                        AscendC::PipeBarrier<PIPE_V>();
                        if (count > 64) {
                            AscendC::Add(parts, parts, highParts, columns * kSlot);
                            AscendC::PipeBarrier<PIPE_V>();
                        }
                        if (k > kKTile) {
                            // Preserve small K-block contributions before later cancellation.
                            // highParts is free after the two half-block sums are merged.
                            AscendC::Sub(parts, parts, corrections, columns * kSlot);
                            AscendC::PipeBarrier<PIPE_V>();
                            AscendC::Add(highParts, sums, parts, columns * kSlot);
                            AscendC::PipeBarrier<PIPE_V>();
                            AscendC::Sub(corrections, highParts, sums, columns * kSlot);
                            AscendC::PipeBarrier<PIPE_V>();
                            AscendC::Sub(corrections, corrections, parts, columns * kSlot);
                            AscendC::DataCopy(sums, highParts, columns * kSlot);
                        } else {
                            AscendC::Add(sums, sums, parts, columns * kSlot);
                        }
                        AscendC::PipeBarrier<PIPE_ALL>();
                        if (columns > 8) {
                            AscendC::Gather(parts, sums, maxOffsets, 0, columns);
                            AscendC::PipeBarrier<PIPE_V>();
                            AscendC::WholeReduceMax(highParts, parts, int32_t(columns), 1, 1, 1, 8,
                                                    AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                            Fence<AscendC::HardEvent::V_S>(pipe);
                            const float value = highParts.GetValue(0);
                            if (first || value > rowMax)
                                rowMax = value;
                            first = false;
                        } else {
                            Fence<AscendC::HardEvent::V_S>(pipe);
                            for (uint32_t col = 0; col < columns; ++col) {
                                const float value = sums.GetValue(col * kSlot);
                                if (first || value > rowMax)
                                    rowMax = value;
                                first = false;
                            }
                        }
                        Fence<AscendC::HardEvent::S_V>(pipe);
                        rowMaxima.SetValue(row - firstRow, rowMax);
                    }
                }
            }
            for (uint32_t row = firstRow; row < lastRow; ++row) {
                const float term = rowMaxima.GetValue(row - firstRow) - sumCorrection;
                const float next = batchSum + term;
                sumCorrection = (next - batchSum) - term;
                batchSum = next;
            }
        } else {
            for (uint32_t row = firstRow; row < lastRow; ++row) {

                for (uint32_t k0 = 0; k0 < k; k0 += kKTile) {
                    const uint32_t count = Min(kKTile, k - k0);
                    if (transA) {
                        const uint32_t offset = bi * m * k + k0 * m + row;
                        AscendC::DataCopyExtParams cp = {uint16_t(count), 2, (m - 1) * 2, 0, 0};
                        AscendC::DataCopyPadExtParams<T> pad = {true, 0, 15, 0};
                        AscendC::DataCopyPad(rawA, a[offset], cp, pad);
                        Fence<AscendC::HardEvent::MTE2_V>(pipe);
                        AscendC::Cast(castA, rawA, AscendC::RoundMode::CAST_NONE, count * 16);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Gather(query[k0], castA, aOffsets, 0, count);
                    } else {
                        const uint32_t aligned = (count + 15) / 16 * 16;
                        AscendC::DataCopyExtParams cp = {1, count * 2, 0, 0, 0};
                        AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(aligned - count), 0};
                        AscendC::DataCopyPad(rawA, a[bi * m * k + row * k + k0], cp, pad);
                        Fence<AscendC::HardEvent::MTE2_V>(pipe);
                        AscendC::Cast(castA, rawA, AscendC::RoundMode::CAST_NONE, aligned);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::DataCopy(query[k0], castA, count);
                    }
                    AscendC::PipeBarrier<PIPE_ALL>();
                }
                float rowMax = 0.0f;
                bool first = true;
                for (uint32_t n0 = 0; n0 < n; n0 += kNTile) {
                    const uint32_t columns = Min(kNTile, n - n0);
                    AscendC::Duplicate(sums, 0.0f, kNTile * kSlot);
                    if (k > kKTile)
                        AscendC::Duplicate(corrections, 0.0f, kNTile * kSlot);
                    AscendC::PipeBarrier<PIPE_V>();
                    for (uint32_t k0 = 0; k0 < k; k0 += kKTile) {
                        const uint32_t count = Min(kKTile, k - k0);
                        const uint32_t pitch = (count + 15) / 16 * 16;
                        if (transB) {
                            AscendC::DataCopyExtParams cp = {uint16_t(columns), count * 2, (k - count) * 2, 0,
                                                             0};
                            AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(pitch - count), 0};
                            AscendC::DataCopyPad(rawB, b[bi * n * k + n0 * k + k0], cp, pad);
                            Fence<AscendC::HardEvent::MTE2_V>(pipe);
                            AscendC::Cast(castB, rawB, AscendC::RoundMode::CAST_NONE, columns * pitch);
                            AscendC::PipeBarrier<PIPE_V>();
                        } else {
                            const uint32_t bPitch = (columns + 15) / 16 * 16;
                            AscendC::DataCopyExtParams cp = {uint16_t(count), columns * 2, (n - columns) * 2,
                                                             0, 0};
                            AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(bPitch - columns), 0};
                            AscendC::DataCopyPad(rawB, b[bi * n * k + k0 * n + n0], cp, pad);
                            Fence<AscendC::HardEvent::MTE2_V>(pipe);
                            AscendC::Cast(castB, rawB, AscendC::RoundMode::CAST_NONE, count * bPitch);
                            AscendC::PipeBarrier<PIPE_V>();
                            if (bPitch == kNTile) {
                                const auto offsets = count == kKTile ? bOffsets : tailOffsets;
                                AscendC::Gather(docs, castB, offsets, 0, columns * count);
                            } else {
                                for (uint32_t col = 0; col < columns; ++col)
                                    AscendC::Gather(docs[col * count], castB, aOffsets, col * sizeof(float), count);
                            }
                            AscendC::PipeBarrier<PIPE_V>();
                        }
                        const auto doc = transB ? castB : docs;
                        const uint32_t docPitch = transB ? pitch : count;
                        const AscendC::BinaryRepeatParams rp = {
                            1, 1, 1, uint8_t(kKTile / kSlot), uint8_t(docPitch / kSlot), 0};

                        for (uint32_t kk = 0; kk < count; kk += 64) {
                            AscendC::Mul(product[kk], doc[kk], query[k0 + kk], uint64_t(Min(64, count - kk)),
                                         uint8_t(columns), rp);
                        }
                        AscendC::PipeBarrier<PIPE_V>();

                        AscendC::WholeReduceSum(parts, product, int32_t(Min(64, count)), int32_t(columns),
                                                kSlot, 1, kKTile / kSlot);
                        if (count > 64)
                            AscendC::WholeReduceSum(highParts, product[64], int32_t(count - 64),
                                                    int32_t(columns), kSlot, 1, kKTile / kSlot);
                        AscendC::PipeBarrier<PIPE_V>();
                        if (count > 64) {
                            AscendC::Add(parts, parts, highParts, columns * kSlot);
                            AscendC::PipeBarrier<PIPE_V>();
                        }
                        if (k > kKTile) {
                            // Preserve small K-block contributions before later cancellation.
                            // highParts is free after the two half-block sums are merged.
                            AscendC::Sub(parts, parts, corrections, columns * kSlot);
                            AscendC::PipeBarrier<PIPE_V>();
                            AscendC::Add(highParts, sums, parts, columns * kSlot);
                            AscendC::PipeBarrier<PIPE_V>();
                            AscendC::Sub(corrections, highParts, sums, columns * kSlot);
                            AscendC::PipeBarrier<PIPE_V>();
                            AscendC::Sub(corrections, corrections, parts, columns * kSlot);
                            AscendC::DataCopy(sums, highParts, columns * kSlot);
                        } else {
                            AscendC::Add(sums, sums, parts, columns * kSlot);
                        }
                        AscendC::PipeBarrier<PIPE_ALL>();
                    }
                    if (columns > 8) {
                        AscendC::Gather(parts, sums, maxOffsets, 0, columns);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::WholeReduceMax(highParts, parts, int32_t(columns), 1, 1, 1, 8,
                                                AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                        Fence<AscendC::HardEvent::V_S>(pipe);
                        const float value = highParts.GetValue(0);
                        if (first || value > rowMax)
                            rowMax = value;
                        first = false;
                    } else {
                        Fence<AscendC::HardEvent::V_S>(pipe);
                        for (uint32_t col = 0; col < columns; ++col) {
                            const float value = sums.GetValue(col * kSlot);
                            if (first || value > rowMax)
                                rowMax = value;
                            first = false;
                        }
                    }
                    Fence<AscendC::HardEvent::S_V>(pipe);
                }
                const float term = rowMax - sumCorrection;
                const float next = batchSum + term;
                sumCorrection = (next - batchSum) - term;
                batchSum = next;
            }
        }
        AscendC::DataCopyExtParams cp = {1, uint32_t(sizeof(float)), 0, 0, 0};
        result.SetValue(0, batchSum);
        Fence<AscendC::HardEvent::S_MTE3>(pipe);
        if (groups == 1) {
            AscendC::DataCopyPad(output[bi], result, cp);
        } else {
            auto incoming = rawABuf.Get<float>();
            float total = 0.0f, correction = 0.0f;
            for (uint32_t step = 0; step < groups; ++step) {
                if (group == step)
                    AscendC::DataCopyPad(output[bi], result, cp);
                AscendC::SyncAll();
                if (group == 0) {
                    AscendC::DataCopyPadExtParams<float> pad = {false, 0, 0, 0};
                    AscendC::DataCopyPad(incoming, output[bi], cp, pad);
                    Fence<AscendC::HardEvent::MTE2_S>(pipe);
                    const float term = incoming.GetValue(0) - correction;
                    const float next = total + term;
                    correction = (next - total) - term;
                    total = next;
                    Fence<AscendC::HardEvent::S_MTE2>(pipe);
                }
                AscendC::SyncAll();
            }
            if (group == 0) {
                result.SetValue(0, total);
                Fence<AscendC::HardEvent::S_MTE3>(pipe);
                AscendC::DataCopyPad(output[bi], result, cp);
            }
        }
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}
} // namespace bmmms

static void RunVector(GM_ADDR x1, const TensorGroupInfo &info_x1, GM_ADDR x2,
                           const TensorGroupInfo &info_x2, GM_ADDR y, const TensorGroupInfo &info_y,
                           int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2) {
    (void)info_y;
    const auto &a = info_x1.tensors[0];
    const auto &b = info_x2.tensors[0];
    const uint32_t batch = uint32_t(a.shape[0]);
    const uint32_t m = uint32_t(a.shape[transposeX1 ? 2 : 1]);
    const uint32_t k = uint32_t(a.shape[transposeX1 ? 1 : 2]);
    const uint32_t n = uint32_t(b.shape[transposeX2 ? 1 : 2]);
    const uint32_t cores = availableCoreNum > 0 ? uint32_t(availableCoreNum) : 1;
    uint32_t groups = 1;
    if (uint64_t(m) * n * k >= (1u << 20) && batch < cores) {
        groups = cores / batch;
        if (groups > m)
            groups = m;
        // Keep the same worst-case row count with fewer collective participants.
        const uint32_t rowsPerGroup = (m + groups - 1) / groups;
        groups = (m + rowsPerGroup - 1) / rowsPerGroup;
    }
    const uint32_t tasks = batch * groups;
    const uint32_t blocks = tasks < cores ? tasks : cores;
    using namespace bmmms;
    if (a.dtype == 1) {
        if (transposeX1) {
            if (transposeX2)
                Baseline<half, true, true><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, groups);
            else
                Baseline<half, true, false><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, groups);
        } else {
            if (transposeX2)
                Baseline<half, false, true><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, groups);
            else
                Baseline<half, false, false><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, groups);
        }
    } else {
        if (transposeX1) {
            if (transposeX2)
                Baseline<bfloat16_t, true, true><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, groups);
            else
                Baseline<bfloat16_t, true, false><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, groups);
        } else {
            if (transposeX2)
                Baseline<bfloat16_t, false, true><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, groups);
            else
                Baseline<bfloat16_t, false, false><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, groups);
        }
    }
}


namespace bmmms_cube {
constexpr uint32_t rows = 32, columns = 64;
template <AscendC::HardEvent event> __aicore__ inline void Fence(AscendC::TPipe &pipe) {
    const auto id = pipe.FetchEventID(event);
    AscendC::SetFlag<event>(id);
    AscendC::WaitFlag<event>(id);
}
template <typename T>
__global__ __mix__(1, 2) void Scores(GM_ADDR x1, GM_ADDR x2, GM_ADDR rowMax,
    __kfc_workspace__ GM_ADDR workspace, AscendC::tiling::TCubeTiling tiling,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, bool ta, bool tb) {
    AscendC::TPipe pipe;
    matmul::Matmul<
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, true>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, true>,
        matmul::MatmulType<AscendC::TPosition::VECIN, CubeFormat::ND, float>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    AscendC::GlobalTensor<T> a, b;
    AscendC::GlobalTensor<float> maxima;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1), batch * m * k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2), batch * n * k);
    maxima.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(rowMax), batch * m);
    AscendC::TBuf<AscendC::TPosition::VECIN> cBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> partialBuf, maxBuf, rowBuf, offsetsBuf;
    AscendC::TBuf<AscendC::TPosition::VECOUT> packedBuf;
    pipe.InitBuffer(cBuf, rows * columns * sizeof(float));
    pipe.InitBuffer(partialBuf, rows * 8 * sizeof(float));
    pipe.InitBuffer(maxBuf, rows * 8 * sizeof(float));
    pipe.InitBuffer(rowBuf, columns * sizeof(float));
    pipe.InitBuffer(offsetsBuf, columns * sizeof(uint32_t));
    pipe.InitBuffer(packedBuf, rows * sizeof(float));
    auto c = cBuf.Get<float>();
    auto partial = partialBuf.Get<float>();
    auto maximum = maxBuf.Get<float>();
    auto packed = packedBuf.Get<float>();
    auto oneRow = rowBuf.Get<float>();
    auto offsets = offsetsBuf.Get<uint32_t>();
    for (uint32_t col = 0; col < columns; ++col) offsets.SetValue(col, col * sizeof(float));
    Fence<AscendC::HardEvent::S_V>(pipe);
    AscendC::Duplicate(partial, 0.0f, rows * 8);
    AscendC::PipeBarrier<PIPE_V>();
    const uint32_t mTiles = (m + rows - 1) / rows;
    // __mix__(1, 2) launches two AIV workers per logical block.
    const uint32_t vectorWorkers = 2 * AscendC::GetBlockNum();
    for (uint32_t task = AscendC::GetBlockIdx(); task < batch * mTiles; task += vectorWorkers) {
        const uint32_t bi = task / mTiles, m0 = task % mTiles * rows;
        const uint32_t validM = m - m0 < rows ? m - m0 : rows;
        for (uint32_t n0 = 0; n0 < n; n0 += columns) {
            const uint32_t validN = n - n0 < columns ? n - n0 : columns;
            mm.SetOrgShape(m, n, k);
            mm.SetSingleShape(validM, validN, k);
            mm.SetTensorA(a[bi * m * k + (ta ? m0 : m0 * k)], ta);
            mm.SetTensorB(b[bi * n * k + (tb ? n0 * k : n0)], tb);
            while (mm.template Iterate<true>()) {
                mm.template GetTensorC<true>(c, 0, true);
                // Sequential ND output is packed with the actual tail width.
                // An unaligned row start cannot be expressed as a repeat stride.
                if (validN % 8 == 0) {
                    AscendC::WholeReduceMax(partial, c, int32_t(validN), int32_t(validM), 8, 1,
                        validN / 8, AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                } else {
                    for (uint32_t row = 0; row < validM; ++row) {
                        AscendC::Gather(oneRow, c, offsets, row * validN * sizeof(float), validN);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::WholeReduceMax(partial[row * 8], oneRow, int32_t(validN), 1, 8, 1,
                            columns / 8, AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                        AscendC::PipeBarrier<PIPE_V>();
                    }
                }
                AscendC::PipeBarrier<PIPE_V>();
                if (n0 == 0) AscendC::DataCopy(maximum, partial, validM * 8);
                else AscendC::Max(maximum, maximum, partial, validM * 8);
                AscendC::PipeBarrier<PIPE_V>();
                // Finish the Vector consumers before Scalar ends this Matmul
                // context or requests another output into the same UB buffer.
                Fence<AscendC::HardEvent::V_S>(pipe);
            }
            mm.End();
        }
        Fence<AscendC::HardEvent::V_S>(pipe);
        for (uint32_t row = 0; row < validM; ++row) packed.SetValue(row, maximum.GetValue(row * 8));
        Fence<AscendC::HardEvent::S_MTE3>(pipe);
        AscendC::DataCopyExtParams cp = {1, validM * uint32_t(sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(maxima[bi * m + m0], packed, cp);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

__global__ __mix__(0, 1) void Finish(GM_ADDR rowMax, GM_ADDR y, uint32_t batch, uint32_t m) {
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<float> maxima, output;
    maxima.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(rowMax), batch * m);
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batch);
    AscendC::TBuf<AscendC::TPosition::VECIN> inBuf;
    AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf;
    pipe.InitBuffer(inBuf, rows * sizeof(float));
    pipe.InitBuffer(outBuf, 32);
    auto values = inBuf.Get<float>(), result = outBuf.Get<float>();
    for (uint32_t bi = AscendC::GetBlockIdx(); bi < batch; bi += AscendC::GetBlockNum()) {
        float total = 0.0f, correction = 0.0f;
        for (uint32_t m0 = 0; m0 < m; m0 += rows) {
            const uint32_t count = m - m0 < rows ? m - m0 : rows;
            AscendC::DataCopyExtParams cp = {1, count * uint32_t(sizeof(float)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<float> pad = {false, 0, 0, 0};
            AscendC::DataCopyPad(values, maxima[bi * m + m0], cp, pad);
            Fence<AscendC::HardEvent::MTE2_S>(pipe);
            for (uint32_t row = 0; row < count; ++row) {
                const float term = values.GetValue(row) - correction;
                const float next = total + term;
                correction = (next - total) - term;
                total = next;
            }
            Fence<AscendC::HardEvent::S_MTE2>(pipe);
        }
        result.SetValue(0, total);
        Fence<AscendC::HardEvent::S_MTE3>(pipe);
        AscendC::DataCopyExtParams cp = {1, uint32_t(sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(output[bi], result, cp);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}
inline void Check(aclError status) {
    if (status != ACL_SUCCESS) throw std::runtime_error("Cube ACL failure: " + std::to_string(status));
}
// A model owns every captured invocation's buffers through its single callback.
// Keeping one state per model also supports multiple calls in the same graph.
struct Scratch { void *workspace; void *maxima; };
struct CapturedScratch {
    aclmdlRI model;
    std::vector<Scratch> calls;
};
inline std::mutex &ScratchMutex() { static std::mutex mutex; return mutex; }
inline std::map<aclmdlRI, std::unique_ptr<CapturedScratch>> &ScratchModels() {
    static std::map<aclmdlRI, std::unique_ptr<CapturedScratch>> models;
    return models;
}
inline void ReleaseCaptured(void *data) {
    auto *state = static_cast<CapturedScratch *>(data);
    std::unique_ptr<CapturedScratch> owned;
    {
        std::lock_guard<std::mutex> lock(ScratchMutex());
        auto &models = ScratchModels();
        const auto it = models.find(state->model);
        if (it == models.end() || it->second.get() != state) {
            std::terminate();
        }
        owned = std::move(it->second);
        models.erase(it);
    }
    // Callback cannot throw through the runtime. Fail fast on cleanup errors.
    // Trace mode independently checks
    // these return codes and allocation/free counts in the validation runner.
    for (const auto &call : owned->calls) {
        const auto rowStatus = aclrtFree(call.maxima);
        const auto workStatus = aclrtFree(call.workspace);
        if (rowStatus != ACL_SUCCESS || workStatus != ACL_SUCCESS)
            std::terminate();
    }
}
inline void RetainCaptured(aclmdlRI model, Scratch scratch) {
    std::lock_guard<std::mutex> lock(ScratchMutex());
    auto &models = ScratchModels();
    const auto old = models.find(model);
    if (old != models.end()) {
        old->second->calls.push_back(scratch);
        return;
    }
    std::unique_ptr<CapturedScratch> state(new CapturedScratch{model, {scratch}});
    auto *data = state.get();
    const auto inserted = models.emplace(model, std::move(state));
    const auto registered = aclmdlRIDestroyRegisterCallback(model, ReleaseCaptured, data);
    if (registered != ACL_SUCCESS) {
        models.erase(inserted.first);
        Check(registered);
    }
}
} // namespace bmmms_cube

static void RunCube(GM_ADDR x1, const TensorGroupInfo &info_x1, GM_ADDR x2,
    const TensorGroupInfo &info_x2, GM_ADDR y, const TensorGroupInfo &, int64_t availableCoreNum,
    aclrtStream stream, bool ta, bool tb) {
    using namespace bmmms_cube;
    const auto &a = info_x1.tensors[0], &b = info_x2.tensors[0];
    const uint32_t batch = a.shape[0], m = a.shape[ta ? 2 : 1];
    const uint32_t k = a.shape[ta ? 1 : 2], n = b.shape[tb ? 1 : 2];
    if (k > 128) throw std::runtime_error("Cube currently requires K <= 128");
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance("Ascend910_9362");
    if (!platform) throw std::runtime_error("Cube platform unavailable");
    matmul_tiling::MatmulApiTiling api(*platform);
    using P = matmul_tiling::TPosition;
    using F = matmul_tiling::CubeFormat;
    using D = matmul_tiling::DataType;
    const auto dtype = a.dtype == 1 ? D::DT_FLOAT16 : D::DT_BF16;
    api.SetAType(P::GM, F::ND, dtype, ta);
    api.SetBType(P::GM, F::ND, dtype, tb);
    api.SetCType(P::LCM, F::ND, D::DT_FLOAT);
    api.SetShape(rows, columns, k);
    api.SetOrgShape(m, n, k);
    api.SetBias(false);
    api.SetFixSplit(rows, columns, -1);
    api.SetBufferSpace(-1, -1, -1);
    AscendC::tiling::TCubeTiling tiling;
    if (api.GetTiling(tiling) == -1 || tiling.baseM != rows || tiling.baseN != columns)
        throw std::runtime_error("Cube tiling rejected fixed tile");
    const size_t workspaceBytes = platform->GetLibApiWorkSpaceSize();
    if (workspaceBytes == UINT32_MAX || !workspaceBytes) throw std::runtime_error("Invalid Cube workspace size");
    aclmdlRICaptureStatus captureStatus = ACL_MODEL_RI_CAPTURE_STATUS_NONE;
    aclmdlRI model = nullptr;
    Check(aclmdlRICaptureGetInfo(stream, &captureStatus, &model));
    if (captureStatus != ACL_MODEL_RI_CAPTURE_STATUS_NONE &&
        (captureStatus != ACL_MODEL_RI_CAPTURE_STATUS_ACTIVE || !model))
        throw std::runtime_error("Invalid Cube stream capture state");
    const bool captured = captureStatus == ACL_MODEL_RI_CAPTURE_STATUS_ACTIVE;
    void *workspace = nullptr, *maxima = nullptr;
    Check(aclrtMalloc(&workspace, workspaceBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    const auto allocated = aclrtMalloc(&maxima, size_t(batch) * m * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    if (allocated != ACL_SUCCESS) { Check(aclrtFree(workspace)); Check(allocated); }
    if (captured) {
        try { RetainCaptured(model, {workspace, maxima}); }
        catch (...) {
            const auto rowStatus = aclrtFree(maxima), workStatus = aclrtFree(workspace);
            Check(rowStatus); Check(workStatus);
            throw;
        }
    }
    const uint32_t cores = availableCoreNum > 0 ? uint32_t(availableCoreNum) : 20;
    const uint32_t tasks = batch * ((m + rows - 1) / rows);
    const uint32_t blocks = (tasks + 1) / 2 < cores ? (tasks + 1) / 2 : cores;
    if (a.dtype == 1)
        Scores<half><<<blocks, nullptr, stream>>>(x1, x2, (GM_ADDR)maxima, (GM_ADDR)workspace, tiling, batch, m, n, k, ta, tb);
    else
        Scores<bfloat16_t><<<blocks, nullptr, stream>>>(x1, x2, (GM_ADDR)maxima, (GM_ADDR)workspace, tiling, batch, m, n, k, ta, tb);
    Finish<<<batch < cores ? batch : cores, nullptr, stream>>>((GM_ADDR)maxima, y, batch, m);
    // Captured tasks execute only on replay; the model callback owns their buffers.
    if (captured) return;
    // Ordinary calls retain buffers until stream completion. A failed sync leaves
    // them alive for caller recovery, rather than freeing potentially live memory.
    const auto sync = aclrtSynchronizeStreamWithTimeout(stream, 60000);
    Check(sync);
    const auto freeMax = aclrtFree(maxima), freeWork = aclrtFree(workspace);
    Check(freeMax); Check(freeWork);
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo &info_x1, GM_ADDR x2,
    const TensorGroupInfo &info_x2, GM_ADDR y, const TensorGroupInfo &info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2) {
    const auto &a = info_x1.tensors[0], &b = info_x2.tensors[0];
    const uint64_t m = a.shape[transposeX1 ? 2 : 1];
    const uint64_t k = a.shape[transposeX1 ? 1 : 2];
    const uint64_t n = b.shape[transposeX2 ? 1 : 2];
    // Restrict Cube to substantial short-K matrices; keep small/long-K work on Vector.
    if (k <= 128 && m >= 256 && n >= 256 && m * n * k >= (1u << 24))
        RunCube(x1, info_x1, x2, info_x2, y, info_y, availableCoreNum, stream, transposeX1, transposeX2);
    else
        RunVector(x1, info_x1, x2, info_x2, y, info_y, availableCoreNum, stream, transposeX1, transposeX2);
}
