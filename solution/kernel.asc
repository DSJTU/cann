#include "kernel_operator.h"
#include <cstdint>
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include <stdexcept>
#include <exception>
#include <map>
#include <memory>
#include <mutex>
#include <vector>

namespace bmmms {
constexpr uint32_t kKTile = 128;
constexpr uint32_t kSlot = 8;
constexpr uint32_t kCachedRows = 128;
__aicore__ inline uint32_t Min(uint32_t a, uint32_t b) { return a < b ? a : b; }
__aicore__ inline uint32_t Align8(uint32_t n) { return (n + 7) / 8 * 8; }
template <AscendC::HardEvent event> __aicore__ inline void Fence(AscendC::TPipe &pipe) {
    const auto id = pipe.FetchEventID(event);
    AscendC::SetFlag<event>(id);
    AscendC::WaitFlag<event>(id);
}

__aicore__ inline void FillOffsets(AscendC::LocalTensor<int32_t> offsets, uint32_t count,
                                   uint32_t stride, uint32_t columns = 1) {
    AscendC::CreateVecIndex(offsets, int32_t(0), count);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::Muls(offsets, offsets, int32_t(stride), count);
    AscendC::PipeBarrier<PIPE_V>();
    for (uint32_t col = 1; col < columns; ++col)
        AscendC::Adds(offsets[col * count], offsets, int32_t(col * sizeof(float)), count);
    AscendC::PipeBarrier<PIPE_V>();
}

__aicore__ inline void DotParts(AscendC::LocalTensor<float> parts,
                                AscendC::LocalTensor<float> highParts,
                                AscendC::LocalTensor<float> product,
                                AscendC::LocalTensor<float> doc,
                                AscendC::LocalTensor<float> query,
                                uint32_t rows, uint32_t columns, uint32_t count,
                                uint32_t tileColumns, uint32_t docPitch,
                                uint32_t queryPitch, uint32_t productRows) {
    const AscendC::BinaryRepeatParams rp = {
        1, 1, 1, uint8_t(kKTile / kSlot), uint8_t(docPitch / kSlot), 0};
    for (uint32_t row0 = 0; row0 < rows;) {
        // Full N tiles make [row,column] a contiguous list of dot products.
        // A partial N tile keeps its padded per-row destination stride.
        const uint32_t groupRows = columns == tileColumns ? Min(productRows, rows - row0) : 1;
        for (uint32_t row = 0; row < groupRows; ++row) {
            for (uint32_t kk = 0; kk < count; kk += 64)
                AscendC::Mul(product[row * tileColumns * kKTile + kk], doc[kk],
                             query[(row0 + row) * queryPitch + kk],
                             uint64_t(Min(64, count - kk)), uint8_t(columns), rp);
        }
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::WholeReduceSum(parts[row0 * tileColumns], product, int32_t(Min(64, count)),
                                int32_t(groupRows * columns), 1, 1, kKTile / kSlot);
        if (count > 64)
            AscendC::WholeReduceSum(highParts[row0 * tileColumns], product[64], int32_t(count - 64),
                                    int32_t(groupRows * columns), 1, 1, kKTile / kSlot);
        // The next group may overwrite the product buffer only after reduction.
        AscendC::PipeBarrier<PIPE_V>();
        row0 += groupRows;
    }
}

template <typename T, bool transA, bool transB>
__schedmode__(1) __global__ __mix__(0, 1) void Baseline(GM_ADDR x1, GM_ADDR x2, GM_ADDR y, uint32_t batch,
                                                        uint32_t m, uint32_t n, uint32_t k, uint32_t groups) {
    const uint32_t kNTile = n <= 16 ? 16 : (transB ? 64 : 32);
    const bool cacheB = k <= kKTile && m >= 16 && n >= 16;
    const uint32_t maxRows = (m + groups - 1) / groups;
    const bool reuseLongB = k > kKTile && maxRows > 1;
    const uint32_t longRows = reuseLongB ? Min(16, maxRows) : 1;
    const bool packedSums = reuseLongB || cacheB;
    const uint32_t batchRows = packedSums ? Min(16, maxRows) : 1;
    const uint32_t productRows = reuseLongB ? Min(longRows, 128 / kNTile) : 1;
    const uint32_t reduceSlot = packedSums ? 1 : kSlot;
    const uint32_t rowSlots = kNTile * reduceSlot;
    const uint32_t queryPitch = (k + 15) / 16 * 16;
    // A partition stays in UB across N tiles when its complete row cache fits.
    // Larger partitions keep the existing one-query path and B reuse.
    const bool cacheA = cacheB && maxRows <= kCachedRows && n > kNTile;
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<T> a, b;
    AscendC::GlobalTensor<float> output;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1), batch * m * k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2), batch * n * k);
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batch);
    AscendC::TBuf<AscendC::TPosition::VECIN> rawABuf, rawBBuf;
    AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> aCastBuf, bCastBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> queryBuf, docBuf, productBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> aOffsetsBuf, bOffsetsBuf, tailOffsetsBuf, maxOffsetsBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> sumsBuf, partBuf, highPartBuf, correctionBuf, rowMaxBuf;

    pipe.InitBuffer(rawABuf, kKTile * 16 * sizeof(T));
    pipe.InitBuffer(rawBBuf, kNTile * kKTile * sizeof(T));
    pipe.InitBuffer(aCastBuf, kKTile * 16 * sizeof(float));
    pipe.InitBuffer(bCastBuf, kNTile * kKTile * sizeof(float));
    pipe.InitBuffer(queryBuf, (reuseLongB ? longRows * kKTile : (cacheA ? maxRows : batchRows) * queryPitch) *
                                  sizeof(float));
    pipe.InitBuffer(docBuf, transB ? 32 : kNTile * kKTile * sizeof(float));
    pipe.InitBuffer(productBuf, productRows * kNTile * kKTile * sizeof(float));
    pipe.InitBuffer(aOffsetsBuf, kKTile * sizeof(uint32_t));
    pipe.InitBuffer(maxOffsetsBuf, kNTile * sizeof(uint32_t));
    pipe.InitBuffer(bOffsetsBuf, transB ? 32 : kNTile * kKTile * sizeof(uint32_t));
    pipe.InitBuffer(tailOffsetsBuf, transB ? 32 : kNTile * kKTile * sizeof(uint32_t));
    pipe.InitBuffer(sumsBuf, batchRows * rowSlots * sizeof(float));
    pipe.InitBuffer(partBuf, batchRows * rowSlots * sizeof(float));
    pipe.InitBuffer(highPartBuf, batchRows * rowSlots * sizeof(float));
    pipe.InitBuffer(correctionBuf, longRows * rowSlots * sizeof(float));
    const uint32_t maximaRows = reuseLongB ? longRows : (cacheB ? maxRows : 1);
    pipe.InitBuffer(rowMaxBuf, ((maximaRows + 7) / 8 * 8) * sizeof(float));
    pipe.InitBuffer(outBuf, 32);
    auto rawA = rawABuf.Get<T>();
    auto rawB = rawBBuf.Get<T>();
    auto castA = aCastBuf.Get<float>();
    auto castB = bCastBuf.Get<float>();
    auto query = queryBuf.Get<float>();
    auto docs = docBuf.Get<float>();
    auto product = productBuf.Get<float>();
    auto aOffsets = aOffsetsBuf.Get<uint32_t>();
    auto maxOffsets = maxOffsetsBuf.Get<uint32_t>();
    auto bOffsets = bOffsetsBuf.Get<uint32_t>();
    auto tailOffsets = tailOffsetsBuf.Get<uint32_t>();
    auto sums = sumsBuf.Get<float>();
    auto parts = partBuf.Get<float>();
    auto highParts = highPartBuf.Get<float>();
    auto corrections = correctionBuf.Get<float>();
    auto result = outBuf.Get<float>();
    auto rowMaxima = rowMaxBuf.Get<float>();
    const uint32_t tailColumns = n % kNTile;
    if (transA || (!transB && kNTile > 16 && tailColumns > 0 && tailColumns <= 16)) {
        FillOffsets(aOffsetsBuf.Get<int32_t>(), Min(kKTile, k), 16 * sizeof(float));
    }
    const uint32_t maxColumns = Min(kNTile, n);
    if (n > 8 && !packedSums) {
        // Continuous vector ops require a 32-byte length. The table is only read
        // up to the valid column count, and kNTile always has room for the pad.
        FillOffsets(maxOffsetsBuf.Get<int32_t>(), Align8(maxColumns), kSlot * sizeof(float));
    }
    const uint32_t tailK = k % kKTile;
    if (!transB) {
        if (k >= kKTile)
            FillOffsets(bOffsetsBuf.Get<int32_t>(), kKTile, kNTile * sizeof(float), maxColumns);
        if (tailK > 0)
            FillOffsets(tailOffsetsBuf.Get<int32_t>(), tailK, kNTile * sizeof(float), maxColumns);
    }

    AscendC::Duplicate(parts, 0.0f, batchRows * rowSlots);
    AscendC::Duplicate(highParts, 0.0f, batchRows * rowSlots);
    AscendC::PipeBarrier<PIPE_V>();

    for (uint32_t task = AscendC::GetBlockIdx(); task < batch * groups; task += AscendC::GetBlockNum()) {
        const uint32_t bi = task / groups;
        const uint32_t group = task % groups;
        const uint32_t firstRow = group * m / groups;
        const uint32_t lastRow = (group + 1) * m / groups;
        float batchSum = 0.0f, sumCorrection = 0.0f;
        if (reuseLongB) {
            // Share each converted B K/N tile across a bounded block of rows.
            // Only the current A K tile lives in UB; every row owns its complete
            // dot-product sum and Kahan correction until all K tiles finish.
            for (uint32_t row0 = firstRow; row0 < lastRow; row0 += longRows) {
                const uint32_t rows = Min(longRows, lastRow - row0);
                for (uint32_t n0 = 0; n0 < n; n0 += kNTile) {
                    const uint32_t columns = Min(kNTile, n - n0);
                    AscendC::Duplicate(sums, 0.0f, rows * rowSlots);
                    AscendC::Duplicate(corrections, 0.0f, rows * rowSlots);
                    AscendC::PipeBarrier<PIPE_V>();
                    for (uint32_t k0 = 0; k0 < k; k0 += kKTile) {
                        const uint32_t count = Min(kKTile, k - k0);
                        const uint32_t pitch = (count + 15) / 16 * 16;
                        if (transB) {
                            AscendC::DataCopyExtParams cp = {uint16_t(columns), count * 2, (k - count) * 2, 0, 0};
                            AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(pitch - count), 0};
                            AscendC::DataCopyPad(rawB, b[bi * n * k + n0 * k + k0], cp, pad);
                            Fence<AscendC::HardEvent::MTE2_V>(pipe);
                            AscendC::Cast(castB, rawB, AscendC::RoundMode::CAST_NONE, columns * pitch);
                            AscendC::PipeBarrier<PIPE_V>();
                        } else {
                            const uint32_t bPitch = (columns + 15) / 16 * 16;
                            AscendC::DataCopyExtParams cp = {uint16_t(count), columns * 2, (n - columns) * 2, 0, 0};
                            AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(bPitch - columns), 0};
                            AscendC::DataCopyPad(rawB, b[bi * n * k + k0 * n + n0], cp, pad);
                            Fence<AscendC::HardEvent::MTE2_V>(pipe);
                            AscendC::Cast(castB, rawB, AscendC::RoundMode::CAST_NONE, count * bPitch);
                            AscendC::PipeBarrier<PIPE_V>();
                            if (bPitch == kNTile) {
                                const auto offsets = count == kKTile ? bOffsets : tailOffsets;
                                AscendC::Gather(docs, castB, offsets, 0, columns * count);
                            } else {
                                for (uint32_t col = 0; col < columns; ++col)
                                    AscendC::Gather(docs[col * count], castB, aOffsets, col * sizeof(float), count);
                            }
                            AscendC::PipeBarrier<PIPE_V>();
                        }
                        if (transA) {
                            AscendC::DataCopyExtParams cp = {uint16_t(count), rows * 2, (m - rows) * 2, 0, 0};
                            AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(16 - rows), 0};
                            AscendC::DataCopyPad(rawA, a[bi * m * k + k0 * m + row0], cp, pad);
                            Fence<AscendC::HardEvent::MTE2_V>(pipe);
                            AscendC::Cast(castA, rawA, AscendC::RoundMode::CAST_NONE, count * 16);
                        } else {
                            AscendC::DataCopyExtParams cp = {uint16_t(rows), count * 2, (k - count) * 2, 0, 0};
                            AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(pitch - count), 0};
                            AscendC::DataCopyPad(rawA, a[bi * m * k + row0 * k + k0], cp, pad);
                            Fence<AscendC::HardEvent::MTE2_V>(pipe);
                            AscendC::Cast(castA, rawA, AscendC::RoundMode::CAST_NONE, rows * pitch);
                        }
                        AscendC::PipeBarrier<PIPE_V>();
                        for (uint32_t localRow = 0; localRow < rows; ++localRow) {
                            if (transA)
                                AscendC::Gather(query[localRow * kKTile], castA, aOffsets,
                                                localRow * sizeof(float), count);
                            else
                                AscendC::DataCopy(query[localRow * kKTile], castA[localRow * pitch], count);
                        }
                        AscendC::PipeBarrier<PIPE_ALL>();
                        const auto doc = transB ? castB : docs;
                        const uint32_t docPitch = transB ? pitch : count;
                        DotParts(parts, highParts, product, doc, query, rows, columns, count,
                                 kNTile, docPitch, kKTile, productRows);
                        const uint32_t stateCount = rows * rowSlots;
                        if (count > 64) {
                            AscendC::Add(parts, parts, highParts, stateCount);
                            AscendC::PipeBarrier<PIPE_V>();
                        }
                        // Each element keeps its original Kahan operations;
                        // independent rows now share one instruction sequence.
                        AscendC::Sub(parts, parts, corrections, stateCount);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Add(highParts, sums, parts, stateCount);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Sub(corrections, highParts, sums, stateCount);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Sub(corrections, corrections, parts, stateCount);
                        AscendC::DataCopy(sums, highParts, stateCount);
                        AscendC::PipeBarrier<PIPE_ALL>();
                    }
                    // Complete K first, then reduce each row over valid columns.
                    AscendC::WholeReduceMax(highParts, sums, int32_t(columns), int32_t(rows),
                                            1, 1, rowSlots / kSlot,
                                            AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                    AscendC::PipeBarrier<PIPE_V>();
                    // Padding past the valid rows stays inside this row-max block and is not summed.
                    const uint32_t packedRows = Align8(rows);
                    if (n0 == 0)
                        AscendC::DataCopy(rowMaxima, highParts, packedRows);
                    else
                        AscendC::Max(rowMaxima, rowMaxima, highParts, packedRows);
                    AscendC::PipeBarrier<PIPE_ALL>();
                }
                Fence<AscendC::HardEvent::V_S>(pipe);
                // The M reduction keeps the original row order across blocks.
                for (uint32_t localRow = 0; localRow < rows; ++localRow) {
                    const float term = rowMaxima.GetValue(localRow) - sumCorrection;
                    const float next = batchSum + term;
                    sumCorrection = (next - batchSum) - term;
                    batchSum = next;
                }
                Fence<AscendC::HardEvent::S_V>(pipe);
            }
        } else if (cacheB) {
            for (uint32_t n0 = 0; n0 < n; n0 += kNTile) {
                const uint32_t columns = Min(kNTile, n - n0);
                const uint32_t k0 = 0;
                const uint32_t count = Min(kKTile, k - k0);
                const uint32_t pitch = (count + 15) / 16 * 16;
                if (transB) {
                    AscendC::DataCopyExtParams cp = {uint16_t(columns), count * 2, (k - count) * 2, 0, 0};
                    AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(pitch - count), 0};
                    AscendC::DataCopyPad(rawB, b[bi * n * k + n0 * k + k0], cp, pad);
                    Fence<AscendC::HardEvent::MTE2_V>(pipe);
                    AscendC::Cast(castB, rawB, AscendC::RoundMode::CAST_NONE, columns * pitch);
                    AscendC::PipeBarrier<PIPE_V>();
                } else {
                    const uint32_t bPitch = (columns + 15) / 16 * 16;
                    AscendC::DataCopyExtParams cp = {uint16_t(count), columns * 2, (n - columns) * 2, 0, 0};
                    AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(bPitch - columns), 0};
                    AscendC::DataCopyPad(rawB, b[bi * n * k + k0 * n + n0], cp, pad);
                    Fence<AscendC::HardEvent::MTE2_V>(pipe);
                    AscendC::Cast(castB, rawB, AscendC::RoundMode::CAST_NONE, count * bPitch);
                    AscendC::PipeBarrier<PIPE_V>();
                    if (bPitch == kNTile) {
                        const auto offsets = count == kKTile ? bOffsets : tailOffsets;
                        AscendC::Gather(docs, castB, offsets, 0, columns * count);
                    } else {
                        for (uint32_t col = 0; col < columns; ++col)
                            AscendC::Gather(docs[col * count], castB, aOffsets, col * sizeof(float), count);
                    }
                    AscendC::PipeBarrier<PIPE_V>();
                }
                for (uint32_t row0 = firstRow; row0 < lastRow; row0 += 16) {
                    const uint32_t rows = Min(16, lastRow - row0);
                    const uint32_t aPitch = (k + 15) / 16 * 16;
                    if ((!cacheA || n0 == 0) && transA) {
                        AscendC::DataCopyExtParams cp = {uint16_t(k), rows * 2, (m - rows) * 2, 0, 0};
                        AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(16 - rows), 0};
                        AscendC::DataCopyPad(rawA, a[bi * m * k + row0], cp, pad);
                        Fence<AscendC::HardEvent::MTE2_V>(pipe);
                        AscendC::Cast(castA, rawA, AscendC::RoundMode::CAST_NONE, k * 16);
                    } else if (!cacheA || n0 == 0) {
                        AscendC::DataCopyExtParams cp = {uint16_t(rows), k * 2, 0, 0, 0};
                        AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(aPitch - k), 0};
                        AscendC::DataCopyPad(rawA, a[bi * m * k + row0 * k], cp, pad);
                        Fence<AscendC::HardEvent::MTE2_V>(pipe);
                        AscendC::Cast(castA, rawA, AscendC::RoundMode::CAST_NONE, rows * aPitch);
                    }
                    AscendC::PipeBarrier<PIPE_V>();
                    const uint32_t queryBase = cacheA ? (row0 - firstRow) * queryPitch : 0;
                    if (!cacheA || n0 == 0) {
                        for (uint32_t localRow = 0; localRow < rows; ++localRow) {
                            const uint32_t queryOffset = queryBase + localRow * queryPitch;
                            if (transA)
                                AscendC::Gather(query[queryOffset], castA, aOffsets, localRow * sizeof(float), k);
                            else
                                AscendC::DataCopy(query[queryOffset], castA[localRow * aPitch], k);
                        }
                    }
                    AscendC::PipeBarrier<PIPE_ALL>();
                    AscendC::Duplicate(sums, 0.0f, rows * rowSlots);
                    AscendC::PipeBarrier<PIPE_V>();
                    const auto doc = transB ? castB : docs;
                    const uint32_t docPitch = transB ? pitch : count;
                    DotParts(parts, highParts, product, doc, query[queryBase], rows, columns, count,
                             kNTile, docPitch, queryPitch, productRows);
                    if (count > 64) {
                        AscendC::Add(parts, parts, highParts, rows * rowSlots);
                        AscendC::PipeBarrier<PIPE_V>();
                    }
                    // Retain the old +0 operation for every valid short-K dot.
                    AscendC::Add(sums, sums, parts, rows * rowSlots);
                    AscendC::PipeBarrier<PIPE_V>();
                    AscendC::WholeReduceMax(highParts, sums, int32_t(columns), int32_t(rows),
                                            1, 1, rowSlots / kSlot,
                                            AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                    AscendC::PipeBarrier<PIPE_V>();
                    auto rowMaxBlock = rowMaxima[row0 - firstRow];
                    const uint32_t packedRows = Align8(rows);
                    if (n0 == 0)
                        AscendC::DataCopy(rowMaxBlock, highParts, packedRows);
                    else
                        AscendC::Max(rowMaxBlock, rowMaxBlock, highParts, packedRows);
                    AscendC::PipeBarrier<PIPE_ALL>();
                }
            }
            Fence<AscendC::HardEvent::V_S>(pipe);
            for (uint32_t row = firstRow; row < lastRow; ++row) {
                const float term = rowMaxima.GetValue(row - firstRow) - sumCorrection;
                const float next = batchSum + term;
                sumCorrection = (next - batchSum) - term;
                batchSum = next;
            }
            Fence<AscendC::HardEvent::S_V>(pipe);
        } else {
            for (uint32_t row = firstRow; row < lastRow; ++row) {

                for (uint32_t k0 = 0; k0 < k; k0 += kKTile) {
                    const uint32_t count = Min(kKTile, k - k0);
                    if (transA) {
                        const uint32_t offset = bi * m * k + k0 * m + row;
                        AscendC::DataCopyExtParams cp = {uint16_t(count), 2, (m - 1) * 2, 0, 0};
                        AscendC::DataCopyPadExtParams<T> pad = {true, 0, 15, 0};
                        AscendC::DataCopyPad(rawA, a[offset], cp, pad);
                        Fence<AscendC::HardEvent::MTE2_V>(pipe);
                        AscendC::Cast(castA, rawA, AscendC::RoundMode::CAST_NONE, count * 16);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::Gather(query[k0], castA, aOffsets, 0, count);
                    } else {
                        const uint32_t aligned = (count + 15) / 16 * 16;
                        AscendC::DataCopyExtParams cp = {1, count * 2, 0, 0, 0};
                        AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(aligned - count), 0};
                        AscendC::DataCopyPad(rawA, a[bi * m * k + row * k + k0], cp, pad);
                        Fence<AscendC::HardEvent::MTE2_V>(pipe);
                        AscendC::Cast(castA, rawA, AscendC::RoundMode::CAST_NONE, aligned);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::DataCopy(query[k0], castA, count);
                    }
                    AscendC::PipeBarrier<PIPE_ALL>();
                }
                float rowMax = 0.0f;
                bool first = true;
                for (uint32_t n0 = 0; n0 < n; n0 += kNTile) {
                    const uint32_t columns = Min(kNTile, n - n0);
                    AscendC::Duplicate(sums, 0.0f, kNTile * kSlot);
                    if (k > kKTile)
                        AscendC::Duplicate(corrections, 0.0f, kNTile * kSlot);
                    AscendC::PipeBarrier<PIPE_V>();
                    for (uint32_t k0 = 0; k0 < k; k0 += kKTile) {
                        const uint32_t count = Min(kKTile, k - k0);
                        const uint32_t pitch = (count + 15) / 16 * 16;
                        if (transB) {
                            AscendC::DataCopyExtParams cp = {uint16_t(columns), count * 2, (k - count) * 2, 0,
                                                             0};
                            AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(pitch - count), 0};
                            AscendC::DataCopyPad(rawB, b[bi * n * k + n0 * k + k0], cp, pad);
                            Fence<AscendC::HardEvent::MTE2_V>(pipe);
                            AscendC::Cast(castB, rawB, AscendC::RoundMode::CAST_NONE, columns * pitch);
                            AscendC::PipeBarrier<PIPE_V>();
                        } else {
                            const uint32_t bPitch = (columns + 15) / 16 * 16;
                            AscendC::DataCopyExtParams cp = {uint16_t(count), columns * 2, (n - columns) * 2,
                                                             0, 0};
                            AscendC::DataCopyPadExtParams<T> pad = {true, 0, uint8_t(bPitch - columns), 0};
                            AscendC::DataCopyPad(rawB, b[bi * n * k + k0 * n + n0], cp, pad);
                            Fence<AscendC::HardEvent::MTE2_V>(pipe);
                            AscendC::Cast(castB, rawB, AscendC::RoundMode::CAST_NONE, count * bPitch);
                            AscendC::PipeBarrier<PIPE_V>();
                            if (bPitch == kNTile) {
                                const auto offsets = count == kKTile ? bOffsets : tailOffsets;
                                AscendC::Gather(docs, castB, offsets, 0, columns * count);
                            } else {
                                for (uint32_t col = 0; col < columns; ++col)
                                    AscendC::Gather(docs[col * count], castB, aOffsets, col * sizeof(float), count);
                            }
                            AscendC::PipeBarrier<PIPE_V>();
                        }
                        const auto doc = transB ? castB : docs;
                        const uint32_t docPitch = transB ? pitch : count;
                        const AscendC::BinaryRepeatParams rp = {
                            1, 1, 1, uint8_t(kKTile / kSlot), uint8_t(docPitch / kSlot), 0};

                        for (uint32_t kk = 0; kk < count; kk += 64) {
                            AscendC::Mul(product[kk], doc[kk], query[k0 + kk], uint64_t(Min(64, count - kk)),
                                         uint8_t(columns), rp);
                        }
                        AscendC::PipeBarrier<PIPE_V>();

                        AscendC::WholeReduceSum(parts, product, int32_t(Min(64, count)), int32_t(columns),
                                                kSlot, 1, kKTile / kSlot);
                        if (count > 64)
                            AscendC::WholeReduceSum(highParts, product[64], int32_t(count - 64),
                                                    int32_t(columns), kSlot, 1, kKTile / kSlot);
                        AscendC::PipeBarrier<PIPE_V>();
                        if (count > 64) {
                            AscendC::Add(parts, parts, highParts, columns * kSlot);
                            AscendC::PipeBarrier<PIPE_V>();
                        }
                        if (k > kKTile) {
                            // Preserve small K-block contributions before later cancellation.
                            // highParts is free after the two half-block sums are merged.
                            AscendC::Sub(parts, parts, corrections, columns * kSlot);
                            AscendC::PipeBarrier<PIPE_V>();
                            AscendC::Add(highParts, sums, parts, columns * kSlot);
                            AscendC::PipeBarrier<PIPE_V>();
                            AscendC::Sub(corrections, highParts, sums, columns * kSlot);
                            AscendC::PipeBarrier<PIPE_V>();
                            AscendC::Sub(corrections, corrections, parts, columns * kSlot);
                            AscendC::DataCopy(sums, highParts, columns * kSlot);
                        } else {
                            AscendC::Add(sums, sums, parts, columns * kSlot);
                        }
                        AscendC::PipeBarrier<PIPE_ALL>();
                    }
                    if (columns > 8) {
                        AscendC::Gather(parts, sums, maxOffsets, 0, columns);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::WholeReduceMax(highParts, parts, int32_t(columns), 1, 1, 1, 8,
                                                AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                        Fence<AscendC::HardEvent::V_S>(pipe);
                        const float value = highParts.GetValue(0);
                        if (first || value > rowMax)
                            rowMax = value;
                        first = false;
                    } else {
                        Fence<AscendC::HardEvent::V_S>(pipe);
                        for (uint32_t col = 0; col < columns; ++col) {
                            const float value = sums.GetValue(col * kSlot);
                            if (first || value > rowMax)
                                rowMax = value;
                            first = false;
                        }
                    }
                    Fence<AscendC::HardEvent::S_V>(pipe);
                }
                const float term = rowMax - sumCorrection;
                const float next = batchSum + term;
                sumCorrection = (next - batchSum) - term;
                batchSum = next;
            }
        }
        AscendC::DataCopyExtParams cp = {1, uint32_t(sizeof(float)), 0, 0, 0};
        result.SetValue(0, batchSum);
        Fence<AscendC::HardEvent::S_MTE3>(pipe);
        if (groups == 1) {
            AscendC::DataCopyPad(output[bi], result, cp);
        } else {
            auto incoming = rawABuf.Get<float>();
            float total = 0.0f, correction = 0.0f;
            for (uint32_t step = 0; step < groups; ++step) {
                if (group == step)
                    AscendC::DataCopyPad(output[bi], result, cp);
                AscendC::SyncAll();
                if (group == 0) {
                    AscendC::DataCopyPadExtParams<float> pad = {false, 0, 0, 0};
                    AscendC::DataCopyPad(incoming, output[bi], cp, pad);
                    Fence<AscendC::HardEvent::MTE2_S>(pipe);
                    const float term = incoming.GetValue(0) - correction;
                    const float next = total + term;
                    correction = (next - total) - term;
                    total = next;
                    Fence<AscendC::HardEvent::S_MTE2>(pipe);
                }
                AscendC::SyncAll();
            }
            if (group == 0) {
                result.SetValue(0, total);
                Fence<AscendC::HardEvent::S_MTE3>(pipe);
                AscendC::DataCopyPad(output[bi], result, cp);
            }
        }
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}
} // namespace bmmms

static void RunVector(GM_ADDR x1, const TensorGroupInfo &info_x1, GM_ADDR x2,
                           const TensorGroupInfo &info_x2, GM_ADDR y, const TensorGroupInfo &info_y,
                           int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2) {
    (void)info_y;
    const auto &a = info_x1.tensors[0];
    const auto &b = info_x2.tensors[0];
    const uint32_t batch = uint32_t(a.shape[0]);
    const uint32_t m = uint32_t(a.shape[transposeX1 ? 2 : 1]);
    const uint32_t k = uint32_t(a.shape[transposeX1 ? 1 : 2]);
    const uint32_t n = uint32_t(b.shape[transposeX2 ? 1 : 2]);
    const uint32_t cores = availableCoreNum > 0 ? uint32_t(availableCoreNum) : 1;
    uint32_t groups = 1;
    if (uint64_t(m) * n * k >= (1u << 20) && batch < cores) {
        groups = cores / batch;
        if (groups > m)
            groups = m;
        // Keep the same worst-case row count with fewer collective participants.
        const uint32_t rowsPerGroup = (m + groups - 1) / groups;
        groups = (m + rowsPerGroup - 1) / rowsPerGroup;
    }
    const uint32_t tasks = batch * groups;
    const uint32_t blocks = tasks < cores ? tasks : cores;
    using namespace bmmms;
    if (a.dtype == 1) {
        if (transposeX1) {
            if (transposeX2)
                Baseline<half, true, true><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, groups);
            else
                Baseline<half, true, false><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, groups);
        } else {
            if (transposeX2)
                Baseline<half, false, true><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, groups);
            else
                Baseline<half, false, false><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, groups);
        }
    } else {
        if (transposeX1) {
            if (transposeX2)
                Baseline<bfloat16_t, true, true><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, groups);
            else
                Baseline<bfloat16_t, true, false><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, groups);
        } else {
            if (transposeX2)
                Baseline<bfloat16_t, false, true><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, groups);
            else
                Baseline<bfloat16_t, false, false><<<blocks, nullptr, stream>>>(x1, x2, y, batch, m, n, k, groups);
        }
    }
}


namespace bmmms_cube {
constexpr uint32_t rows = 32, columns = 64;
// Short K: one request owns this many columns. Iterate still returns
// columns-wide base tiles, N-major, because singleM never exceeds baseM.
constexpr uint32_t shortWindow = 1024;
// Long K: each Cube accumulation stays 128 wide. One IterateBatch consumes every
// 128-wide panel of a 64x64 tile. Panels are packed into contiguous ND matrices
// because a slice of [M, K] is not itself a contiguous [M, 128] matrix.
constexpr uint32_t kLongRows = 64, kPanelK = 128;
template <AscendC::HardEvent event> __aicore__ inline void Fence(AscendC::TPipe &pipe) {
    const auto id = pipe.FetchEventID(event);
    AscendC::SetFlag<event>(id);
    AscendC::WaitFlag<event>(id);
}
__aicore__ inline void AbsorbTile(AscendC::TPipe &pipe, AscendC::LocalTensor<float> partial,
    AscendC::LocalTensor<float> maximum, AscendC::LocalTensor<float> tile,
    AscendC::LocalTensor<float> oneRow, AscendC::LocalTensor<uint32_t> offsets,
    uint32_t validM, uint32_t tileCols, bool first, uint32_t pitch = 0) {
    const uint32_t rowPitch = pitch == 0 ? tileCols : pitch;
    if (tileCols % 8 == 0 && rowPitch % 8 == 0) {
        AscendC::WholeReduceMax(partial, tile, int32_t(tileCols), int32_t(validM), 8, 1,
            rowPitch / 8, AscendC::ReduceOrder::ORDER_ONLY_VALUE);
    } else {
        for (uint32_t row = 0; row < validM; ++row) {
            AscendC::Gather(oneRow, tile, offsets, row * rowPitch * sizeof(float), tileCols);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::WholeReduceMax(partial[row * 8], oneRow, int32_t(tileCols), 1, 8, 1,
                columns / 8, AscendC::ReduceOrder::ORDER_ONLY_VALUE);
            AscendC::PipeBarrier<PIPE_V>();
        }
    }
    AscendC::PipeBarrier<PIPE_V>();
    if (first) AscendC::DataCopy(maximum, partial, validM * 8);
    else AscendC::Max(maximum, maximum, partial, validM * 8);
    AscendC::PipeBarrier<PIPE_V>();
    Fence<AscendC::HardEvent::V_S>(pipe);
}
template <typename T>
__aicore__ inline void Scores(GM_ADDR x1, GM_ADDR x2, GM_ADDR rowMax,
    GM_ADDR workspace, AscendC::tiling::TCubeTiling tiling,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, bool ta, bool tb) {
    AscendC::TPipe pipe;
    matmul::Matmul<
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, true>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, true>,
        matmul::MatmulType<AscendC::TPosition::VECIN, CubeFormat::ND, float>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    AscendC::GlobalTensor<T> a, b;
    AscendC::GlobalTensor<float> maxima;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1), batch * m * k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2), batch * n * k);
    maxima.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(rowMax), batch * m);
    AscendC::TBuf<AscendC::TPosition::VECIN> cBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> partialBuf, maxBuf, rowBuf, offsetsBuf;
    AscendC::TBuf<AscendC::TPosition::VECOUT> packedBuf;
    pipe.InitBuffer(cBuf, rows * columns * sizeof(float));
    pipe.InitBuffer(partialBuf, rows * 8 * sizeof(float));
    pipe.InitBuffer(maxBuf, rows * 8 * sizeof(float));
    pipe.InitBuffer(rowBuf, columns * sizeof(float));
    pipe.InitBuffer(offsetsBuf, columns * sizeof(uint32_t));
    pipe.InitBuffer(packedBuf, rows * sizeof(float));
    auto c = cBuf.Get<float>();
    auto partial = partialBuf.Get<float>();
    auto maximum = maxBuf.Get<float>();
    auto packed = packedBuf.Get<float>();
    auto oneRow = rowBuf.Get<float>();
    auto offsets = offsetsBuf.Get<uint32_t>();
    for (uint32_t col = 0; col < columns; ++col) offsets.SetValue(col, col * sizeof(float));
    Fence<AscendC::HardEvent::S_V>(pipe);
    AscendC::Duplicate(partial, 0.0f, rows * 8);
    AscendC::PipeBarrier<PIPE_V>();
    const uint32_t mTiles = (m + rows - 1) / rows;
    // __mix__(1, 2) launches two AIV workers per logical block.
    const uint32_t vectorWorkers = 2 * AscendC::GetBlockNum();
    for (uint32_t task = AscendC::GetBlockIdx(); task < batch * mTiles; task += vectorWorkers) {
        const uint32_t bi = task / mTiles, m0 = task % mTiles * rows;
        const uint32_t validM = m - m0 < rows ? m - m0 : rows;
        for (uint32_t n0 = 0; n0 < n; n0 += shortWindow) {
            const uint32_t validN = n - n0 < shortWindow ? n - n0 : shortWindow;
            mm.SetOrgShape(m, n, k);
            mm.SetSingleShape(validM, validN, k);
            mm.SetTensorA(a[bi * m * k + (ta ? m0 : m0 * k)], ta);
            mm.SetTensorB(b[bi * n * k + (tb ? n0 * k : n0)], tb);
            uint32_t produced = 0;
            while (mm.template Iterate<true>()) {
                const uint32_t tileCols = validN - produced < columns ? validN - produced : columns;
                mm.template GetTensorC<true>(c, 0, true);
                // Sequential ND output is packed with this base tile's width.
                AbsorbTile(pipe, partial, maximum, c, oneRow, offsets, validM, tileCols,
                    n0 == 0 && produced == 0);
                produced += tileCols;
            }
            mm.End();
        }
        Fence<AscendC::HardEvent::V_S>(pipe);
        for (uint32_t row = 0; row < validM; ++row) packed.SetValue(row, maximum.GetValue(row * 8));
        Fence<AscendC::HardEvent::S_MTE3>(pipe);
        AscendC::DataCopyExtParams cp = {1, validM * uint32_t(sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(maxima[bi * m + m0], packed, cp);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

template <typename T>
__aicore__ inline void ZeroGm(AscendC::TPipe &pipe, AscendC::GlobalTensor<T> dst,
    AscendC::LocalTensor<T> tmp, uint32_t elems) {
    // tmp holds one 64x128 panel. A previous copy may still be reading it.
    constexpr uint32_t chunk = kLongRows * kPanelK;
    Fence<AscendC::HardEvent::MTE3_V>(pipe);
    AscendC::Duplicate(tmp, T(0), chunk);
    AscendC::PipeBarrier<PIPE_V>();
    Fence<AscendC::HardEvent::V_MTE3>(pipe);
    for (uint32_t at = 0; at < elems; at += chunk) {
        const uint32_t n = elems - at < chunk ? elems - at : chunk;
        AscendC::DataCopyExtParams cp = {1, n * uint32_t(sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(dst[at], tmp, cp);
    }
    Fence<AscendC::HardEvent::MTE3_MTE2>(pipe);
}
template <typename T>
__aicore__ inline void CopyRect(AscendC::TPipe &pipe, AscendC::GlobalTensor<T> dst, uint32_t dstGap,
    AscendC::GlobalTensor<T> src, uint32_t srcGap, AscendC::LocalTensor<T> tmp,
    uint32_t rectRows, uint32_t width) {
    AscendC::DataCopyExtParams inbound = {uint16_t(rectRows), width * uint32_t(sizeof(T)),
        srcGap * uint32_t(sizeof(T)), 0, 0};
    AscendC::DataCopyPadExtParams<T> pad = {false, 0, 0, T(0)};
    AscendC::DataCopyPad(tmp, src, inbound, pad);
    Fence<AscendC::HardEvent::MTE2_MTE3>(pipe);
    AscendC::DataCopyExtParams outbound = {uint16_t(rectRows), width * uint32_t(sizeof(T)),
        0, dstGap * uint32_t(sizeof(T)), 0};
    AscendC::DataCopyPad(dst, tmp, outbound);
    Fence<AscendC::HardEvent::MTE3_MTE2>(pipe);
}
// A reference template argument needs linkage, which a function-local constexpr lacks.
// Full-K packs exceed L1, so this mode streams one panel at a time inside one call.
static constexpr matmul::MatmulConfig kPanelConfig = matmul::GetNormalConfig(
    false, false, false, matmul::BatchMode::BATCH_LARGE_THAN_L1);
template <typename T>
__aicore__ inline void LongScores(GM_ADDR x1, GM_ADDR x2, GM_ADDR rowMax,
    GM_ADDR workspace, GM_ADDR panelScratch, AscendC::tiling::TCubeTiling tiling,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, uint32_t nGroups,
    uint32_t panels, uint32_t aBytes, uint32_t bBytes, uint32_t slotBytes, bool ta, bool tb) {
    (void)workspace;
    AscendC::TPipe pipe;
    using AType = matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, true, matmul::LayoutMode::NORMAL>;
    using BType = matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, true, matmul::LayoutMode::NORMAL>;
    using CType = matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float, false, matmul::LayoutMode::NORMAL>;
    using BiasType = matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>;
    matmul::Matmul<AType, BType, CType, BiasType, kPanelConfig> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    AscendC::GlobalTensor<T> a, b;
    AscendC::GlobalTensor<float> maxima;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1), batch * m * k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2), batch * n * k);
    maxima.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(rowMax), batch * m * nGroups);
    const uint32_t tileElems = kLongRows * columns;
    const uint32_t strideA = kLongRows * kPanelK, strideB = kPanelK * columns, strideC = tileElems;
    auto *base = panelScratch + AscendC::GetBlockIdx() * slotBytes;
    AscendC::GlobalTensor<T> packedA, packedB;
    AscendC::GlobalTensor<float> packedC;
    packedA.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(base), panels * strideA);
    packedB.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(base + aBytes), panels * strideB);
    packedC.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(base + aBytes + bBytes), panels * strideC);
    AscendC::TBuf<AscendC::TPosition::VECIN> cBuf, packBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> partialBuf, maxBuf, rowBuf, offsetsBuf, sumBuf, correctionBuf, nextBuf;
    AscendC::TBuf<AscendC::TPosition::VECOUT> packedBuf;
    pipe.InitBuffer(cBuf, tileElems * sizeof(float));
    pipe.InitBuffer(packBuf, kLongRows * kPanelK * sizeof(T));
    pipe.InitBuffer(sumBuf, tileElems * sizeof(float));
    pipe.InitBuffer(correctionBuf, tileElems * sizeof(float));
    pipe.InitBuffer(nextBuf, tileElems * sizeof(float));
    pipe.InitBuffer(partialBuf, kLongRows * 8 * sizeof(float));
    pipe.InitBuffer(maxBuf, kLongRows * 8 * sizeof(float));
    pipe.InitBuffer(rowBuf, columns * sizeof(float));
    pipe.InitBuffer(offsetsBuf, columns * sizeof(uint32_t));
    pipe.InitBuffer(packedBuf, kLongRows * sizeof(float));
    auto c = cBuf.Get<float>();
    auto pack = packBuf.Get<T>();
    auto sums = sumBuf.Get<float>();
    auto corrections = correctionBuf.Get<float>();
    auto next = nextBuf.Get<float>();
    auto partial = partialBuf.Get<float>();
    auto maximum = maxBuf.Get<float>();
    auto packed = packedBuf.Get<float>();
    auto oneRow = rowBuf.Get<float>();
    auto offsets = offsetsBuf.Get<uint32_t>();
    for (uint32_t col = 0; col < columns; ++col) offsets.SetValue(col, col * sizeof(float));
    Fence<AscendC::HardEvent::S_V>(pipe);
    AscendC::Duplicate(partial, 0.0f, kLongRows * 8);
    AscendC::PipeBarrier<PIPE_V>();
    const uint32_t mTiles = (m + kLongRows - 1) / kLongRows;
    const uint32_t nTiles = nGroups;
    const uint32_t groupTiles = ((n + columns - 1) / columns + nGroups - 1) / nGroups;
    // __mix__(1, 2) launches two AIV workers per logical block.
    const uint32_t vectorWorkers = 2 * AscendC::GetBlockNum();
    for (uint32_t task = AscendC::GetBlockIdx(); task < batch * mTiles * nTiles; task += vectorWorkers) {
        const uint32_t bi = task / (mTiles * nTiles);
        const uint32_t m0 = task / nTiles % mTiles * kLongRows, ni = task % nTiles;
        const uint32_t validM = m - m0 < kLongRows ? m - m0 : kLongRows;
        const uint32_t nBegin = ni * groupTiles * columns;
        const uint32_t nLimit = (ni + 1) * groupTiles * columns;
        const uint32_t nEnd = n < nLimit ? n : nLimit;
        // A depends only on this M tile, so every N tile in the group reuses it.
        // A full 64x128 panel is overwritten by the copy. Zero only a short M or K tail,
        // and do that one panel at a time so the pad stays zero without a second pass.
        const bool shortM = validM != kLongRows;
        for (uint32_t panel = 0; panel < panels; ++panel) {
            const uint32_t k0 = panel * kPanelK;
            const uint32_t validK = k - k0 < kPanelK ? k - k0 : kPanelK;
            if (shortM || validK != kPanelK)
                ZeroGm(pipe, packedA[panel * strideA], pack, strideA);
            if (!ta)
                CopyRect(pipe, packedA[panel * strideA], kPanelK - validK,
                    a[bi * m * k + m0 * k + k0], k - validK, pack, validM, validK);
            else
                CopyRect(pipe, packedA[panel * strideA], kLongRows - validM,
                    a[bi * m * k + k0 * m + m0], m - validM, pack, validK, validM);
        }
        for (uint32_t n0 = nBegin; n0 < nEnd; n0 += columns) {
            const uint32_t validN = nEnd - n0 < columns ? nEnd - n0 : columns;
            const bool shortN = validN != columns;
            for (uint32_t panel = 0; panel < panels; ++panel) {
                const uint32_t k0 = panel * kPanelK;
                const uint32_t validK = k - k0 < kPanelK ? k - k0 : kPanelK;
                if (shortN || validK != kPanelK)
                    ZeroGm(pipe, packedB[panel * strideB], pack, strideB);
                if (!tb)
                    CopyRect(pipe, packedB[panel * strideB], columns - validN,
                        b[bi * n * k + k0 * n + n0], n - validN, pack, validK, validN);
                else
                    CopyRect(pipe, packedB[panel * strideB], kPanelK - validK,
                        b[bi * n * k + n0 * k + k0], k - validK, pack, validN, validK);
            }
            Fence<AscendC::HardEvent::MTE3_S>(pipe);
            mm.SetOrgShape(kLongRows, columns, kPanelK);
            mm.SetTensorA(packedA, ta);
            mm.SetTensorB(packedB, tb);
            mm.IterateBatch(packedC, panels, panels, true, strideA, strideB, strideC);
            AscendC::Duplicate(sums, 0.0f, tileElems);
            AscendC::Duplicate(corrections, 0.0f, tileElems);
            AscendC::PipeBarrier<PIPE_V>();
            Fence<AscendC::HardEvent::V_S>(pipe);
            AscendC::DataCopyExtParams tileCopy = {1, tileElems * uint32_t(sizeof(float)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<float> tilePad = {false, 0, 0, 0};
            for (uint32_t panel = 0; panel < panels; ++panel) {
                AscendC::DataCopyPad(c, packedC[panel * strideC], tileCopy, tilePad);
                Fence<AscendC::HardEvent::MTE2_V>(pipe);
                AscendC::Sub(c, c, corrections, tileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Add(next, sums, c, tileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Sub(corrections, next, sums, tileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Sub(corrections, corrections, c, tileElems);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::DataCopy(sums, next, tileElems);
                AscendC::PipeBarrier<PIPE_V>();
                // The next panel reuses c only after this compensation finishes.
                Fence<AscendC::HardEvent::V_S>(pipe);
            }
            AbsorbTile(pipe, partial, maximum, sums, oneRow, offsets, validM, validN, n0 == nBegin, columns);
        }
        Fence<AscendC::HardEvent::V_S>(pipe);
        for (uint32_t row = 0; row < validM; ++row) packed.SetValue(row, maximum.GetValue(row * 8));
        Fence<AscendC::HardEvent::S_MTE3>(pipe);
        AscendC::DataCopyExtParams cp = {1, validM * uint32_t(sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(maxima[(bi * nTiles + ni) * m + m0], packed, cp);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

__aicore__ inline void Finish(GM_ADDR rowMax, GM_ADDR y, uint32_t batch, uint32_t m,
    uint32_t nTiles, uint32_t workers) {
    // Allocate only this shape's aligned rows. Maximum owned UB is 176 KiB + 32 B.
    const uint32_t padded = bmmms::Align8(m);
    const uint32_t halfRows = bmmms::Align8((m + 1) / 2);
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<float> maxima, output;
    maxima.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(rowMax), batch * m * nTiles);
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batch);
    AscendC::TBuf<AscendC::TPosition::VECIN> hiBuf, loBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> aBuf, bBuf, sBuf, bpBuf, errBuf, tmpBuf, offsetBuf;
    AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf;
    pipe.InitBuffer(hiBuf, padded * sizeof(float));
    pipe.InitBuffer(loBuf, padded * sizeof(float));
    pipe.InitBuffer(aBuf, halfRows * sizeof(float));
    pipe.InitBuffer(bBuf, halfRows * sizeof(float));
    pipe.InitBuffer(sBuf, halfRows * sizeof(float));
    pipe.InitBuffer(bpBuf, halfRows * sizeof(float));
    pipe.InitBuffer(errBuf, halfRows * sizeof(float));
    pipe.InitBuffer(tmpBuf, halfRows * sizeof(float));
    pipe.InitBuffer(offsetBuf, halfRows * sizeof(float));
    pipe.InitBuffer(outBuf, 32);
    auto hi = hiBuf.Get<float>(), lo = loBuf.Get<float>();
    auto a = aBuf.Get<float>(), b = bBuf.Get<float>(), s = sBuf.Get<float>();
    auto bp = bpBuf.Get<float>(), err = errBuf.Get<float>(), tmp = tmpBuf.Get<float>();
    auto offsets = offsetBuf.Get<uint32_t>();
    auto result = outBuf.Get<float>();
    bmmms::FillOffsets(offsetBuf.Get<int32_t>(), halfRows, 2 * sizeof(float));
    for (uint32_t bi = AscendC::GetBlockIdx(); bi < batch; bi += workers) {
        AscendC::DataCopyExtParams cp = {1, m * 4, 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> pad = {true, 0, uint8_t(padded - m), 0};
        AscendC::DataCopyPad(hi, maxima[bi * nTiles * m], cp, pad);
        Fence<AscendC::HardEvent::MTE2_V>(pipe);
        AscendC::PipeBarrier<PIPE_V>();
        for (uint32_t ni = 1; ni < nTiles; ++ni) {
            // Finish reading lo before the next DMA overwrites it.
            Fence<AscendC::HardEvent::V_S>(pipe);
            Fence<AscendC::HardEvent::S_MTE2>(pipe);
            AscendC::DataCopyPad(lo, maxima[(bi * nTiles + ni) * m], cp, pad);
            Fence<AscendC::HardEvent::MTE2_V>(pipe);
            AscendC::Max(hi, hi, lo, padded);
            AscendC::PipeBarrier<PIPE_V>();
        }
        // Reuse the N-merge input buffer as the summation low component.
        AscendC::Duplicate(lo, 0.0f, padded);
        AscendC::PipeBarrier<PIPE_V>();
        // Every level leaves zero padding, so an odd final child pairs with zero.
        // The fixed tree carries FP32 high/low components instead of dropping
        // each pair's rounding error before later cancellation.
        for (uint32_t count = m; count > 1; count = (count + 1) / 2) {
            const uint32_t pairs = (count + 1) / 2, aligned = (pairs + 7) / 8 * 8;
            AscendC::Duplicate(tmp, 0.0f, aligned);
            AscendC::Duplicate(err, 0.0f, aligned);
            AscendC::Gather(a, hi, offsets, 0, pairs);
            AscendC::Gather(b, hi, offsets, 4, pairs);
            AscendC::PipeBarrier<PIPE_V>();
            // Exact-error transform of the high components.
            AscendC::Add(s, a, b, pairs); AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(bp, s, a, pairs); AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(tmp, s, bp, pairs); AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(tmp, a, tmp, pairs); AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(err, b, bp, pairs); AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(err, tmp, err, pairs); AscendC::PipeBarrier<PIPE_V>();
            AscendC::Gather(a, lo, offsets, 0, pairs);
            AscendC::Gather(b, lo, offsets, 4, pairs);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(bp, a, b, pairs); AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(err, err, bp, pairs); AscendC::PipeBarrier<PIPE_V>();
            // Renormalize high + carried error with a second TwoSum.
            AscendC::Add(tmp, s, err, pairs); AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(bp, tmp, s, pairs); AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(a, tmp, bp, pairs); AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(a, s, a, pairs); AscendC::PipeBarrier<PIPE_V>();
            AscendC::Sub(b, err, bp, pairs); AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(err, a, b, pairs); AscendC::PipeBarrier<PIPE_V>();
            AscendC::DataCopy(hi, tmp, aligned);
            AscendC::DataCopy(lo, err, aligned);
            AscendC::PipeBarrier<PIPE_V>();
        }
        Fence<AscendC::HardEvent::V_S>(pipe);
        result.SetValue(0, hi.GetValue(0) + lo.GetValue(0));
        Fence<AscendC::HardEvent::S_MTE3>(pipe);
        cp.blockLen = 4;
        AscendC::DataCopyPad(output[bi], result, cp);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}
template <typename T>
__schedmode__(1) __global__ __mix__(1, 2) void Fused(GM_ADDR x1, GM_ADDR x2, GM_ADDR rowMax, GM_ADDR y,
    __kfc_workspace__ GM_ADDR workspace, GM_ADDR panelScratch, AscendC::tiling::TCubeTiling tiling,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, uint32_t nGroups,
    uint32_t panels, uint32_t aBytes, uint32_t bBytes, uint32_t slotBytes, bool ta, bool tb) {
    // Matmul's AIC service and its TPipe are destroyed when this helper returns.
    // Finish then owns a fresh TPipe, so the two phases reuse the same UB space.
    if (k > 128)
        LongScores<T>(x1, x2, rowMax, workspace, panelScratch, tiling, batch, m, n, k, nGroups,
            panels, aBytes, bBytes, slotBytes, ta, tb);
    else Scores<T>(x1, x2, rowMax, workspace, tiling, batch, m, n, k, ta, tb);
    if ASCEND_IS_AIV {
        // Every AIV reaches this once, including workers with no score tasks.
        // Producers complete MTE3 before this collective; no partial row is read.
        AscendC::SyncAll();
        Finish(rowMax, y, batch, m, nGroups, 2 * AscendC::GetBlockNum());
    }
}

inline void Check(aclError status) {
    if (status != ACL_SUCCESS) throw std::runtime_error("Cube ACL failure: " + std::to_string(status));
}
// A model owns every captured invocation's buffers through its single callback.
// Keeping one state per model also supports multiple calls in the same graph.
struct Scratch { void *workspace; void *maxima; void *panels; };
struct CapturedScratch {
    aclmdlRI model;
    std::vector<Scratch> calls;
};
inline std::mutex &ScratchMutex() { static std::mutex mutex; return mutex; }
inline std::map<aclmdlRI, std::unique_ptr<CapturedScratch>> &ScratchModels() {
    static std::map<aclmdlRI, std::unique_ptr<CapturedScratch>> models;
    return models;
}
inline void ReleaseCaptured(void *data) {
    auto *state = static_cast<CapturedScratch *>(data);
    std::unique_ptr<CapturedScratch> owned;
    {
        std::lock_guard<std::mutex> lock(ScratchMutex());
        auto &models = ScratchModels();
        const auto it = models.find(state->model);
        if (it == models.end() || it->second.get() != state) {
            std::terminate();
        }
        owned = std::move(it->second);
        models.erase(it);
    }
    // Callback cannot throw through the runtime. Fail fast on cleanup errors.
    // Trace mode independently checks
    // these return codes and allocation/free counts in the validation runner.
    for (const auto &call : owned->calls) {
        const auto rowStatus = aclrtFree(call.maxima);
        const auto workStatus = aclrtFree(call.workspace);
        const auto panelStatus = call.panels ? aclrtFree(call.panels) : ACL_SUCCESS;
        if (rowStatus != ACL_SUCCESS || workStatus != ACL_SUCCESS || panelStatus != ACL_SUCCESS)
            std::terminate();
    }
}
inline void RetainCaptured(aclmdlRI model, Scratch scratch) {
    std::lock_guard<std::mutex> lock(ScratchMutex());
    auto &models = ScratchModels();
    const auto old = models.find(model);
    if (old != models.end()) {
        old->second->calls.push_back(scratch);
        return;
    }
    std::unique_ptr<CapturedScratch> state(new CapturedScratch{model, {scratch}});
    auto *data = state.get();
    const auto inserted = models.emplace(model, std::move(state));
    const auto registered = aclmdlRIDestroyRegisterCallback(model, ReleaseCaptured, data);
    if (registered != ACL_SUCCESS) {
        models.erase(inserted.first);
        Check(registered);
    }
}
} // namespace bmmms_cube

static void RunCube(GM_ADDR x1, const TensorGroupInfo &info_x1, GM_ADDR x2,
    const TensorGroupInfo &info_x2, GM_ADDR y, const TensorGroupInfo &, int64_t availableCoreNum,
    aclrtStream stream, bool ta, bool tb) {
    using namespace bmmms_cube;
    const auto &a = info_x1.tensors[0], &b = info_x2.tensors[0];
    const uint32_t batch = a.shape[0], m = a.shape[ta ? 2 : 1];
    const uint32_t k = a.shape[ta ? 1 : 2], n = b.shape[tb ? 1 : 2];
    const bool longK = k > 128;
    const uint32_t tileRows = longK ? kLongRows : rows;
    const uint32_t cores = availableCoreNum > 0 ? uint32_t(availableCoreNum) : 20;
    const uint32_t mTasks = batch * ((m + tileRows - 1) / tileRows);
    const uint32_t columnTiles = (n + columns - 1) / columns;
    uint32_t nGroups = 1;
    if (longK) {
        nGroups = (2 * cores + mTasks - 1) / mTasks;
        if (nGroups > columnTiles) nGroups = columnTiles;
        const uint32_t groupTiles = (columnTiles + nGroups - 1) / nGroups;
        nGroups = (columnTiles + groupTiles - 1) / groupTiles;
    }
    if (k > 8192) throw std::runtime_error("Cube K out of range");
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance("Ascend910_9362");
    if (!platform) throw std::runtime_error("Cube platform unavailable");
    matmul_tiling::MatmulApiTiling api(*platform);
    using P = matmul_tiling::TPosition;
    using F = matmul_tiling::CubeFormat;
    using D = matmul_tiling::DataType;
    const auto dtype = a.dtype == 1 ? D::DT_FLOAT16 : D::DT_BF16;
    api.SetAType(P::GM, F::ND, dtype, ta);
    api.SetBType(P::GM, F::ND, dtype, tb);
    api.SetBias(false);
    api.SetBufferSpace(-1, -1, -1);
    uint32_t panels = 0, aBytes = 0, bBytes = 0, slotBytes = 0;
    if (longK) {
        // Packed panels are contiguous 64x128 and 128x64 matrices, not the original stride.
        api.SetCType(P::GM, F::ND, D::DT_FLOAT);
        api.SetShape(kLongRows, columns, kPanelK);
        api.SetOrgShape(kLongRows, columns, kPanelK);
        panels = (k + kPanelK - 1) / kPanelK;
        const auto align = [](size_t bytes) { return (bytes + 511) & ~size_t(511); };
        aBytes = uint32_t(align(size_t(panels) * kLongRows * kPanelK * 2));
        bBytes = uint32_t(align(size_t(panels) * kPanelK * columns * 2));
        slotBytes = aBytes + bBytes + uint32_t(align(size_t(panels) * kLongRows * columns * sizeof(float)));
        if (api.SetBatchInfoForNormal(int32_t(panels), int32_t(panels), int32_t(kLongRows),
                int32_t(columns), int32_t(kPanelK)) == -1)
            throw std::runtime_error("Cube batch tiling rejected");
    } else {
        api.SetCType(P::LCM, F::ND, D::DT_FLOAT);
        api.SetShape(rows, shortWindow, k < 128 ? k : 128);
        api.SetOrgShape(m, n, k);
    }
    api.SetFixSplit(tileRows, columns, -1);
    AscendC::tiling::TCubeTiling tiling;
    if (api.GetTiling(tiling) == -1 || tiling.baseM != tileRows || tiling.baseN != columns)
        throw std::runtime_error("Cube tiling rejected fixed tile");
    const size_t workspaceBytes = platform->GetLibApiWorkSpaceSize();
    if (workspaceBytes == UINT32_MAX || !workspaceBytes) throw std::runtime_error("Invalid Cube workspace size");
    aclmdlRICaptureStatus captureStatus = ACL_MODEL_RI_CAPTURE_STATUS_NONE;
    aclmdlRI model = nullptr;
    Check(aclmdlRICaptureGetInfo(stream, &captureStatus, &model));
    if (captureStatus != ACL_MODEL_RI_CAPTURE_STATUS_NONE &&
        (captureStatus != ACL_MODEL_RI_CAPTURE_STATUS_ACTIVE || !model))
        throw std::runtime_error("Invalid Cube stream capture state");
    const bool captured = captureStatus == ACL_MODEL_RI_CAPTURE_STATUS_ACTIVE;
    const uint32_t tasks = mTasks * nGroups;
    const uint32_t blocks = (tasks + 1) / 2 < cores ? (tasks + 1) / 2 : cores;
    void *workspace = nullptr, *maxima = nullptr, *panelsGm = nullptr;
    Check(aclrtMalloc(&workspace, workspaceBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    const auto allocated = aclrtMalloc(&maxima, size_t(batch) * m * nGroups * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    if (allocated != ACL_SUCCESS) { Check(aclrtFree(workspace)); Check(allocated); }
    if (longK) {
        const auto panelStatus = aclrtMalloc(&panelsGm, size_t(slotBytes) * 2 * blocks, ACL_MEM_MALLOC_HUGE_FIRST);
        if (panelStatus != ACL_SUCCESS) {
            Check(aclrtFree(maxima));
            Check(aclrtFree(workspace));
            Check(panelStatus);
        }
    }
    if (captured) {
        try { RetainCaptured(model, {workspace, maxima, panelsGm}); }
        catch (...) {
            const auto rowStatus = aclrtFree(maxima), workStatus = aclrtFree(workspace);
            const auto panelFree = panelsGm ? aclrtFree(panelsGm) : ACL_SUCCESS;
            Check(rowStatus); Check(workStatus); Check(panelFree);
            throw;
        }
    }
    if (a.dtype == 1)
        Fused<half><<<blocks, nullptr, stream>>>(x1, x2, (GM_ADDR)maxima, y, (GM_ADDR)workspace, (GM_ADDR)panelsGm,
            tiling, batch, m, n, k, nGroups, panels, aBytes, bBytes, slotBytes, ta, tb);
    else
        Fused<bfloat16_t><<<blocks, nullptr, stream>>>(x1, x2, (GM_ADDR)maxima, y, (GM_ADDR)workspace, (GM_ADDR)panelsGm,
            tiling, batch, m, n, k, nGroups, panels, aBytes, bBytes, slotBytes, ta, tb);
    // Captured tasks execute only on replay; the model callback owns their buffers.
    if (captured) return;
    // Ordinary calls retain buffers until stream completion. A failed sync leaves
    // them alive for caller recovery, rather than freeing potentially live memory.
    const auto sync = aclrtSynchronizeStreamWithTimeout(stream, 60000);
    Check(sync);
    const auto freeMax = aclrtFree(maxima), freeWork = aclrtFree(workspace);
    const auto freePanels = panelsGm ? aclrtFree(panelsGm) : ACL_SUCCESS;
    Check(freeMax); Check(freeWork); Check(freePanels);
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo &info_x1, GM_ADDR x2,
    const TensorGroupInfo &info_x2, GM_ADDR y, const TensorGroupInfo &info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2) {
    const auto &a = info_x1.tensors[0], &b = info_x2.tensors[0];
    const uint64_t m = a.shape[transposeX1 ? 2 : 1];
    const uint64_t k = a.shape[transposeX1 ? 1 : 2];
    const uint64_t n = b.shape[transposeX2 ? 1 : 2];
    const uint64_t batch = a.shape[0];
    // Small/narrow work stays on Vector. Long-K Cube packs every 128-wide K panel
    // of one 64x64 tile into a single IterateBatch, then compensates across panels.
    const bool shortCube = k <= 128 && m >= 256 && n >= 256 && m * n * k >= (1u << 24);
    const bool longCube = k > 128 && m >= 16 && n >= 64 && batch * m * n * k >= (1ull << 22);
    if (shortCube || longCube)
        RunCube(x1, info_x1, x2, info_x2, y, info_y, availableCoreNum, stream, transposeX1, transposeX2);
    else
        RunVector(x1, info_x1, x2, info_x2, y, info_y, availableCoreNum, stream, transposeX1, transposeX2);
}
