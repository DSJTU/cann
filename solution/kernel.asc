// BatchMatmulMaxSum -- CANN 9.0, dav-2201. Included by the judge; no main/guards.
#include <algorithm>
#include <cmath>
#include <cstdint>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"

#ifndef BMMMS_MAX_TILE_M
#define BMMMS_MAX_TILE_M 128
#endif
#ifndef BMMMS_MAX_TILE_N
#define BMMMS_MAX_TILE_N 128
#endif

namespace bmmms {
using namespace AscendC;
struct Schedule {
    uint32_t batches, m, n, k;
    uint32_t tileM, tileN, mTiles, paddedM;
    uint32_t nSplits, nTiles, tilesPerSplit, workers;
    uint32_t tasks, direct, windowTiles;
};

template <typename T, bool TA, bool TB>
class FusedMaxSim {
public:
    __aicore__ inline FusedMaxSim() {}
    using AType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, T, TA>;
    using BType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, T, TB>;
    using CType = matmul::MatmulType<TPosition::VECIN, CubeFormat::ND, float>;
    using BiasType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, float>;
    matmul::Matmul<AType, BType, CType, BiasType> mm;
    AscendC::tiling::TCubeTiling tiling;

    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR tiles, GM_ADDR partial,
        GM_ADDR y, Schedule schedule, AscendC::tiling::TCubeTiling cubeTiling, TPipe* pipe) {
        p = schedule;
        tiling = cubeTiling;
        aGm.SetGlobalBuffer((__gm__ T*)a);
        bGm.SetGlobalBuffer((__gm__ T*)b);
        tileBase = (__gm__ float*)tiles;
        partialGm.SetGlobalBuffer((__gm__ float*)partial);
        yGm.SetGlobalBuffer((__gm__ float*)y);
        mte2ToScalar = static_cast<event_t>(pipe->FetchEventID(HardEvent::MTE2_S));
        reduceRows = Min(p.paddedM, 4096U);
        const uint32_t inputCount = p.tileM * p.tileN > reduceRows ?
                                    p.tileM * p.tileN : reduceRows;
        const uint32_t sumCount = p.tileM > 64U ? p.tileM : 64U;
        // The final reduction reuses these buffers after the AIV barrier.
        // At most 4096 rows are resident, keeping UB plus Matmul below 192 KiB.
        pipe->InitBuffer(cQueue, 2, inputCount * sizeof(float));
        pipe->InitBuffer(maxBuffer, reduceRows * sizeof(float));
        pipe->InitBuffer(rowBuffer, p.tileM * sizeof(float));
        pipe->InitBuffer(sumBuffer, sumCount * sizeof(float));
        pipe->InitBuffer(chunkBuffer, 64);
        pipe->InitBuffer(outQueue, 1, p.tileM * sizeof(float));
    }

    __aicore__ inline void Process() {
        LocalTensor<float> maxima = maxBuffer.Get<float>();
        LocalTensor<float> rows = rowBuffer.Get<float>();
        const uint32_t workerElements = p.windowTiles * p.tileM * p.tileN;
        const uint64_t tileOffset = uint64_t(GetBlockIdx()) * workerElements;
        GlobalTensor<float> workerScratch;
        workerScratch.SetGlobalBuffer(tileBase + tileOffset, workerElements);
        mm.SetWorkspace(workerScratch);
        for (uint32_t task = GetBlockIdx(); task < p.tasks; task += p.workers) {
            const uint32_t split = task % p.nSplits;
            const uint32_t rowTask = task / p.nSplits;
            const uint32_t batch = rowTask / p.mTiles;
            const uint32_t mStart = (rowTask % p.mTiles) * p.tileM;
            const uint32_t validM = Min(p.tileM, p.m - mStart);
            const uint32_t firstNTile = split * p.nTiles / p.nSplits;
            const uint32_t endNTile = (split + 1) * p.nTiles / p.nSplits;
            const uint64_t aOffset = uint64_t(batch) * p.m * p.k +
                                     (TA ? mStart : uint64_t(mStart) * p.k);
            PipeBarrier<PIPE_V>();
            Duplicate(maxima, -INFINITY, p.tileM);
            PipeBarrier<PIPE_V>();
            for (uint32_t first = firstNTile; first < endNTile; first += p.windowTiles) {
                const uint32_t nStart = first * p.tileN;
                const uint32_t windowEnd = Min(first + p.windowTiles, endNTile);
                const uint32_t validN = Min(windowEnd * p.tileN, p.n) - nStart;
                const uint64_t bOffset = uint64_t(batch) * p.n * p.k +
                                         (TB ? uint64_t(nStart) * p.k : nStart);
                mm.SetTensorA(aGm[aOffset], TA);
                mm.SetTensorB(bGm[bOffset], TB);
                mm.SetTail(validM, validN, p.k);
                // One request computes this N window (at most eight tiles). Cube continues
                // producing distinct slots while Vector consumes earlier slots.
                mm.template Iterate<false>();
                uint32_t nDone = 0;
                while (nDone < validN) {
                    const uint32_t cols = Min(p.tileN, validN - nDone);
                    // The async overload returns one ready baseM*baseN GM slot.
                    // Valid ND rows inside each slot remain tightly packed.
                    GlobalTensor<float> ready = mm.template GetTensorC<false>();
                    LocalTensor<float> c = cQueue.AllocTensor<float>();
                    DataCopyExtParams copy{static_cast<uint16_t>(validM),
                        static_cast<uint32_t>(cols * sizeof(float)), 0, 0, 0};
                    DataCopyPadExtParams<float> pad{false, 0, 0, 0.0f};
                    DataCopyPad(c, ready, copy, pad);
                    cQueue.EnQue(c);
                    c = cQueue.DeQue<float>();
                    const uint32_t rowStride = (cols + 7) / 8 * 8;
                    // Each repeat reduces one row; never include padded N lanes.
                    // An all-negative row must stay negative.
                    for (uint32_t col = 0; col < cols; col += 64) {
                        PipeBarrier<PIPE_V>();
                        WholeReduceMax(rows, c[col], Min(64U, cols - col), validM,
                                       1, 1, rowStride / 8, ReduceOrder::ORDER_ONLY_VALUE);
                        PipeBarrier<PIPE_V>();
                        Max(maxima, maxima, rows, validM);
                    }
                    cQueue.FreeTensor(c);
                    nDone += cols;
                }
                // Reuse this worker's slots only after all old GM reads finish.
                // No per-tile Scalar fence is needed for distinct slots.
                SetFlag<HardEvent::MTE2_S>(mte2ToScalar);
                WaitFlag<HardEvent::MTE2_S>(mte2ToScalar);
                mm.End();
            }
            PipeBarrier<PIPE_V>();
            LocalTensor<float> out = outQueue.AllocTensor<float>();
            if (p.direct) {
                ReduceSum(out, maxima, sumBuffer.Get<float>(), validM);
                outQueue.EnQue(out);
                out = outQueue.DeQue<float>();
                DataCopyExtParams copy{1, sizeof(float), 0, 0, 0};
                DataCopyPad(yGm[batch], out, copy);
            } else {
                Adds(out, maxima, 0.0f, p.tileM);
                outQueue.EnQue(out);
                out = outQueue.DeQue<float>();
                const uint64_t offset = (uint64_t(batch) * p.nSplits + split) * p.paddedM + mStart;
                DataCopy(partialGm[offset], out, p.tileM);
            }
            outQueue.FreeTensor(out);
        }
    }

    __aicore__ inline void Finish() {
        LocalTensor<float> maxima = maxBuffer.Get<float>();
        LocalTensor<float> work = sumBuffer.Get<float>();
        LocalTensor<float> chunks = chunkBuffer.Get<float>();
        for (uint32_t batch = GetBlockIdx(); batch < p.batches; batch += p.workers) {
            LocalTensor<float> out = outQueue.AllocTensor<float>();
            const bool twoChunks = p.m > reduceRows;
            if (twoChunks) {
                Duplicate(chunks, 0.0f, 16);
                PipeBarrier<PIPE_V>();
            }
            for (uint32_t mStart = 0; mStart < p.m; mStart += reduceRows) {
                const uint32_t count = Min(reduceRows, p.paddedM - mStart);
                const uint32_t valid = Min(count, p.m - mStart);
                for (uint32_t split = 0; split < p.nSplits; ++split) {
                    LocalTensor<float> in = cQueue.AllocTensor<float>();
                    const uint64_t offset =
                        (uint64_t(batch) * p.nSplits + split) * p.paddedM + mStart;
                    DataCopy(in, partialGm[offset], count);
                    cQueue.EnQue(in);
                    in = cQueue.DeQue<float>();
                    if (split == 0) Adds(maxima, in, 0.0f, count);
                    else Max(maxima, maxima, in, count);
                    PipeBarrier<PIPE_V>();
                    cQueue.FreeTensor(in);
                }
                // Each destination is 32-byte aligned. Padding contributes
                // neither to Max(N) nor to Sum(M); the reduction is deterministic.
                if (twoChunks) ReduceSum(chunks[(mStart / reduceRows) * 8], maxima, work, valid);
                else ReduceSum(out, maxima, work, valid);
                PipeBarrier<PIPE_V>();
            }
            if (twoChunks) {
                ReduceSum(out, chunks, work, 16);
                PipeBarrier<PIPE_V>();
            }
            outQueue.EnQue(out);
            out = outQueue.DeQue<float>();
            DataCopyExtParams copy{1, sizeof(float), 0, 0, 0};
            DataCopyPad(yGm[batch], out, copy);
            outQueue.FreeTensor(out);
        }
    }
private:
    __aicore__ inline uint32_t Min(uint32_t a, uint32_t b) { return a < b ? a : b; }
    Schedule p;
    uint32_t reduceRows;
    event_t mte2ToScalar;
    GlobalTensor<T> aGm, bGm;
    __gm__ float* tileBase;
    GlobalTensor<float> partialGm, yGm;
    TQue<TPosition::VECIN, 2> cQueue;
    TQue<TPosition::VECOUT, 1> outQueue;
    TBuf<TPosition::VECCALC> maxBuffer, rowBuffer, sumBuffer, chunkBuffer;
};

template <typename T, bool TA, bool TB>
__schedmode__(1) __global__ __mix__(1, 2) void fused_kernel(GM_ADDR a, GM_ADDR b, GM_ADDR tiles,
    GM_ADDR partial, GM_ADDR y, __kfc_workspace__ GM_ADDR workspace, Schedule p,
    AscendC::tiling::TCubeTiling tiling) {
    TPipe pipe;
    FusedMaxSim<T, TA, TB> op;
    op.Init(a, b, tiles, partial, y, p, tiling, &pipe);
    // Register on BOTH AIC/AIV before any per-task branch. The compiler sets
    // the system workspace from the __kfc_workspace__ argument.
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), op.mm, &op.tiling);
    op.Process();
    if (!p.direct) {
        // REGIST runs the AIC server separately. Synchronize AIVs only,
        // including workers with no task, after every partial MTE3 write.
        SyncAll<true>();
        op.Finish();
    }
}

inline uint32_t CeilDiv(uint32_t x, uint32_t d) { return (x + d - 1) / d; }
struct Plan {
    aclrtContext context;
    uint32_t b, m, n, k, cores;
    int32_t dtype;
    bool ta, tb;
    Schedule p;
    AscendC::tiling::TCubeTiling tiling;
    size_t systemBytes, tileBytes, partialBytes;
};
inline bool MakePlan(aclrtContext context, uint32_t b, uint32_t m, uint32_t n, uint32_t k,
                     uint32_t cores, int32_t dtype, bool ta, bool tb, Plan& plan) {
    plan.context = context;
    plan.b = b; plan.m = m; plan.n = n; plan.k = k; plan.cores = cores;
    plan.dtype = dtype; plan.ta = ta; plan.tb = tb;
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) return false;
    const uint32_t maxWorkers = 2 * cores;
    Schedule& p = plan.p;
    p.batches = b; p.m = m; p.n = n; p.k = k;
    uint32_t targetM = BMMMS_MAX_TILE_M;
    p.tileN = std::min(uint32_t(BMMMS_MAX_TILE_N), CeilDiv(n, 16) * 16);
    // N partitions also supply parallelism. Do not double the M-tile count
    // when the original M*N grid can already occupy the available workers.
    if (uint64_t(b) * CeilDiv(m, targetM) * CeilDiv(n, p.tileN) < maxWorkers &&
        targetM > 64) targetM = 64;
    p.tileM = std::min(targetM, CeilDiv(m, 16) * 16);
    // Retain 16-element alignment even for rounded shapes such as M=65.
    p.tileM = std::min(p.tileM, (16384U / p.tileN / 16) * 16);
    p.mTiles = CeilDiv(m, p.tileM);
    p.paddedM = p.mTiles * p.tileM;
    p.nTiles = CeilDiv(n, p.tileN);
    const uint32_t rowTasks = b * p.mTiles;
    const uint32_t wantedSplits = std::min(p.nTiles, CeilDiv(maxWorkers, rowTasks));
    p.tilesPerSplit = CeilDiv(p.nTiles, wantedSplits);
    p.windowTiles = std::min(p.tilesPerSplit, 8U);
    p.nSplits = wantedSplits; // balanced floor(i*nTiles/nSplits) boundaries
    p.tasks = rowTasks * p.nSplits;
    p.workers = 2 * std::min(cores, CeilDiv(p.tasks, 2));
    p.direct = p.mTiles == 1 && p.nSplits == 1;
    matmul_tiling::MatmulApiTiling cube(*platform);
    const auto dt = dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16 :
                                matmul_tiling::DataType::DT_BFLOAT16;
    if (cube.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dt, ta) != 0)
        return false;
    if (cube.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dt, tb) != 0)
        return false;
    cube.SetCType(matmul_tiling::TPosition::VECIN, matmul_tiling::CubeFormat::ND,
                  matmul_tiling::DataType::DT_FLOAT);
    cube.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                     matmul_tiling::DataType::DT_FLOAT);
    cube.SetBias(false);
    cube.SetShape(std::min(m, p.tileM), std::min(n, p.windowTiles * p.tileN), k);
    cube.SetOrgShape(m, n, k);
    cube.SetFixSplit(p.tileM, p.tileN, -1);
    cube.SetBufferSpace(-1, -1, 32 * 1024);
    if (cube.GetTiling(plan.tiling) == -1) return false;
    if (plan.tiling.baseM != p.tileM || plan.tiling.baseN != p.tileN) return false;
    const uint32_t systemBytes = platform->GetLibApiWorkSpaceSize();
    if (systemBytes == 0 || systemBytes == UINT32_MAX) return false;
    plan.systemBytes = (size_t(systemBytes) + 511) / 512 * 512;
    plan.tileBytes = size_t(p.workers) * p.windowTiles * p.tileM * p.tileN * sizeof(float);
    plan.partialBytes = p.direct ? 0 : size_t(b) * p.nSplits * p.paddedM * sizeof(float);
    return true;
}

// Cache only tiling and scratch, never inputs/results. Same-stream launches
// are ordered by ACL; scratch can be reused without synchronizing each call.
struct Scratch { aclrtContext context; aclrtStream stream; void* address; size_t bytes; };
inline std::vector<Scratch>& ScratchCache() {
    static thread_local std::vector<Scratch> cache;
    return cache;
}
inline void* GetScratch(aclrtContext context, aclrtStream stream, size_t bytes) {
    auto& cache = ScratchCache();
    for (auto& item : cache) {
        if (item.context != context || item.stream != stream) continue;
        if (item.bytes < bytes) {
            if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) return nullptr;
            void* replacement = nullptr;
            if (aclrtMalloc(&replacement, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
                return nullptr;
            if (aclrtFree(item.address) != ACL_SUCCESS) {
                aclrtFree(replacement);
                return nullptr;
            }
            item.address = replacement;
            item.bytes = bytes;
        }
        return item.address;
    }
    Scratch item{context, stream, nullptr, bytes};
    if (aclrtMalloc(&item.address, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS)
        return nullptr;
    cache.push_back(item);
    return item.address;
}
template <typename T, bool TA, bool TB>
inline void Launch(GM_ADDR a, GM_ADDR b, GM_ADDR y, aclrtStream stream, const Plan& plan, GM_ADDR ws) {
    const Schedule& p = plan.p;
    GM_ADDR tiles = ws + plan.systemBytes;
    GM_ADDR partial = tiles + plan.tileBytes;
    fused_kernel<T, TA, TB><<<p.workers / 2, nullptr, stream>>>(a, b, tiles, partial, y, ws, p, plan.tiling);
}
template <typename T>
inline void Dispatch(GM_ADDR a, GM_ADDR b, GM_ADDR y, aclrtStream stream, const Plan& plan, GM_ADDR ws) {
    if (plan.ta) {
        if (plan.tb) Launch<T, true, true>(a, b, y, stream, plan, ws);
        else Launch<T, true, false>(a, b, y, stream, plan, ws);
    } else {
        if (plan.tb) Launch<T, false, true>(a, b, y, stream, plan, ws);
        else Launch<T, false, false>(a, b, y, stream, plan, ws);
    }
}
} // namespace bmmms

// M == N == 1 specialization. Include after kernel_operator.h.
// All four storage layouts are identical in this case: [B, K].
// Supports half/bfloat16_t, 32 <= K <= 8192, K % 8 == 0.
template <typename T>
class BmmmsDotKernel {
public:
    __aicore__ inline BmmmsDotKernel() {}
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                uint32_t batch, uint32_t k)
    {
        batch_ = batch;
        k_ = k;
        inputStride_ = (k + 15U) & ~15U;
        floatStride_ = (k + 63U) & ~63U;
        const uint32_t scratchCount =
            ((floatStride_ / 64U + 7U) / 8U) * 8U;
        x1_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x1));
        x2_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x2));
        y_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y));
        pipe_.InitBuffer(input_, 1, 2U * inputStride_ * sizeof(T));
        pipe_.InitBuffer(output_, 1, 32U);
        pipe_.InitBuffer(floatBuffer_, 2U * floatStride_ * sizeof(float));
        pipe_.InitBuffer(scratch_, scratchCount * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<float> lhs = floatBuffer_.Get<float>();
        AscendC::LocalTensor<float> rhs = lhs[floatStride_];
        AscendC::LocalTensor<float> work = scratch_.Get<float>();
        AscendC::DataCopyExtParams inputCopy{
            1, static_cast<uint32_t>(k_ * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> inputPad{false, 0, 0, T(0)};
        AscendC::DataCopyExtParams outputCopy{1, sizeof(float), 0, 0, 0};

        for (uint32_t b = AscendC::GetBlockIdx(); b < batch_;
             b += AscendC::GetBlockNum()) {
            AscendC::LocalTensor<T> input = input_.AllocTensor<T>();
            const uint64_t offset = static_cast<uint64_t>(b) * k_;
            // Exact byte count: even K == 8 (mod 16) never overreads GM.
            // Each input occupies a separately aligned region in UB.
            AscendC::DataCopyPad(input, x1_[offset], inputCopy, inputPad);
            AscendC::DataCopyPad(input[inputStride_], x2_[offset],
                                inputCopy, inputPad);
            input_.EnQue(input);
            input = input_.DeQue<T>(); // MTE2 -> V dependency.

            AscendC::Cast(lhs, input, AscendC::RoundMode::CAST_NONE, k_);
            AscendC::Cast(rhs, input[inputStride_],
                         AscendC::RoundMode::CAST_NONE, k_);
            AscendC::PipeBarrier<PIPE_V>();
            // Multiply in FP32; half/bfloat16 products are not rounded back
            // to the input format. Exact source/destination alias is valid.
            AscendC::Mul(lhs, lhs, rhs, k_);
            if (k_ >= 64U && k_ != floatStride_) {
                // K % 8 == 0 makes lhs[k_] 32-byte aligned.
                AscendC::Duplicate(lhs[k_], 0.0f, floatStride_ - k_);
            }
            AscendC::PipeBarrier<PIPE_V>();

            AscendC::LocalTensor<float> result = output_.AllocTensor<float>();
            if (k_ <= 64U) {
                AscendC::WholeReduceSum(result, lhs, static_cast<int32_t>(k_), 1, 1, 1, 8);
            } else {
                // The explicit repeat form uses binary-tree accumulation
                // across repeats on A2/A3, avoiding a long serial FP32 sum.
                AscendC::ReduceSum(result, lhs, work, 64,
                                  static_cast<int32_t>(floatStride_ / 64U), 8);
            }
            // Protect lhs/work when this core advances to another batch.
            AscendC::PipeBarrier<PIPE_V>();
            input_.FreeTensor(input); // Reuse waits for the V consumer.
            output_.EnQue(result);
            result = output_.DeQue<float>(); // V -> MTE3 dependency.
            // A masked MTE3 transfer writes exactly one float. Do not use
            // scalar GM stores: adjacent batches can share a cache line.
            AscendC::DataCopyPad(y_[b], result, outputCopy);
            output_.FreeTensor(result); // Reuse waits for MTE3 completion.
        }
    }

private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> input_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> output_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> floatBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scratch_;
    AscendC::GlobalTensor<T> x1_;
    AscendC::GlobalTensor<T> x2_;
    AscendC::GlobalTensor<float> y_;
    uint32_t batch_;
    uint32_t k_;
    uint32_t inputStride_;
    uint32_t floatStride_;
};

template <typename T>
__global__ __vector__ void bmmms_dot_kernel(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                      uint32_t B, uint32_t K)
{
    BmmmsDotKernel<T> op;
    op.Init(x1, x2, y, B, K);
    op.Process();
}

// Small matrices stay entirely in UB. Each repeat computes a different N
// dot product, broadcasting the same A row through a zero repeat stride.
template <typename T, bool TA, bool TB>
class BmmmsSmallKernel {
public:
    __aicore__ inline BmmmsSmallKernel() {}
    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR y,
        uint32_t batches, uint32_t m, uint32_t n, uint32_t k) {
        batches_ = batches; m_ = m; n_ = n; k_ = k;
        aCount_ = m * k; bCount_ = n * k;
        inputOffset_ = (aCount_ + 15) / 16 * 16;
        nPad_ = (n + 7) / 8 * 8;
        groups_ = (k + 63) / 64;
        aGm_.SetGlobalBuffer((__gm__ T*)a);
        bGm_.SetGlobalBuffer((__gm__ T*)b);
        yGm_.SetGlobalBuffer((__gm__ float*)y);
        pipe_.InitBuffer(input_, 1, (inputOffset_ + (bCount_ + 15) / 16 * 16) * sizeof(T));
        pipe_.InitBuffer(output_, 1, 32);
        pipe_.InitBuffer(aBuffer_, aCount_ * sizeof(float));
        pipe_.InitBuffer(bBuffer_, bCount_ * sizeof(float));
        const uint32_t tempCount = aCount_ > bCount_ ? aCount_ : bCount_;
        pipe_.InitBuffer(tempBuffer_, tempCount * sizeof(float));
        pipe_.InitBuffer(productBuffer_, bCount_ * sizeof(float));
        pipe_.InitBuffer(indexBuffer_, 2 * k * sizeof(int32_t));
        pipe_.InitBuffer(partBuffer_, groups_ * nPad_ * sizeof(float));
        pipe_.InitBuffer(maxBuffer_, (m + 7) / 8 * 8 * sizeof(float));
    }
    __aicore__ inline void Process() {
        using namespace AscendC;
        LocalTensor<float> a = aBuffer_.Get<float>();
        LocalTensor<float> b = bBuffer_.Get<float>();
        LocalTensor<float> temp = tempBuffer_.Get<float>();
        LocalTensor<float> product = productBuffer_.Get<float>();
        LocalTensor<float> parts = partBuffer_.Get<float>();
        LocalTensor<float> maxima = maxBuffer_.Get<float>();
        LocalTensor<int32_t> indexA = indexBuffer_.Get<int32_t>();
        LocalTensor<int32_t> indexB = indexA[k_];
        if (TA) CreateVecIndex(indexA, int32_t(0), k_);
        if (!TB) CreateVecIndex(indexB, int32_t(0), k_);
        PipeBarrier<PIPE_V>();
        if (TA) Muls(indexA, indexA, int32_t(m_ * sizeof(float)), k_);
        if (!TB) Muls(indexB, indexB, int32_t(n_ * sizeof(float)), k_);
        PipeBarrier<PIPE_V>();
        const DataCopyExtParams copyA{1, static_cast<uint32_t>(aCount_ * sizeof(T)), 0, 0, 0};
        const DataCopyExtParams copyB{1, static_cast<uint32_t>(bCount_ * sizeof(T)), 0, 0, 0};
        const DataCopyPadExtParams<T> pad{false, 0, 0, T(0)};
        const BinaryRepeatParams broadcast{1, 1, 1,
            static_cast<uint8_t>(k_ / 8), 0, static_cast<uint8_t>(k_ / 8)};
        for (uint32_t batch = GetBlockIdx(); batch < batches_; batch += GetBlockNum()) {
            LocalTensor<T> input = input_.AllocTensor<T>();
            DataCopyPad(input, aGm_[uint64_t(batch) * aCount_], copyA, pad);
            DataCopyPad(input[inputOffset_], bGm_[uint64_t(batch) * bCount_], copyB, pad);
            input_.EnQue(input);
            input = input_.DeQue<T>();
            if (TA) {
                Cast(temp, input, RoundMode::CAST_NONE, aCount_);
                PipeBarrier<PIPE_V>();
                for (uint32_t row = 0; row < m_; ++row)
                    Gather(a[row * k_], temp, indexA.ReinterpretCast<uint32_t>(),
                           row * sizeof(float), k_);
            } else {
                Cast(a, input, RoundMode::CAST_NONE, aCount_);
            }
            PipeBarrier<PIPE_V>();
            if (TB) {
                Cast(b, input[inputOffset_], RoundMode::CAST_NONE, bCount_);
            } else {
                Cast(temp, input[inputOffset_], RoundMode::CAST_NONE, bCount_);
                PipeBarrier<PIPE_V>();
                for (uint32_t row = 0; row < n_; ++row)
                    Gather(b[row * k_], temp, indexB.ReinterpretCast<uint32_t>(),
                           row * sizeof(float), k_);
            }
            PipeBarrier<PIPE_V>();
            input_.FreeTensor(input);
            for (uint32_t row = 0; row < m_; ++row) {
                for (uint32_t group = 0; group < groups_; ++group) {
                    const uint32_t offset = group * 64;
                    const uint32_t width = k_ - offset < 64 ? k_ - offset : 64;
                    Mul(product[offset], a[row * k_ + offset], b[offset],
                        width, n_, broadcast);
                    PipeBarrier<PIPE_V>();
                    WholeReduceSum(parts[group * nPad_], product[offset], width,
                                   n_, 1, 1, k_ / 8);
                    PipeBarrier<PIPE_V>();
                }
                // Pairwise combination preserves FP32 accumulation without
                // a serial K loop or one scalar reduction per (m,n) pair.
                for (uint32_t step = 1; step < groups_; step *= 2) {
                    for (uint32_t group = 0; group + step < groups_; group += 2 * step)
                        Add(parts[group * nPad_], parts[group * nPad_],
                            parts[(group + step) * nPad_], n_);
                    PipeBarrier<PIPE_V>();
                }
                WholeReduceMax(maxima[row], parts, n_, 1, 1, 1, 8,
                               ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
            }
            LocalTensor<float> out = output_.AllocTensor<float>();
            WholeReduceSum(out, maxima, m_, 1, 1, 1, 8);
            PipeBarrier<PIPE_V>();
            output_.EnQue(out);
            out = output_.DeQue<float>();
            DataCopyExtParams copy{1, sizeof(float), 0, 0, 0};
            DataCopyPad(yGm_[batch], out, copy);
            output_.FreeTensor(out);
        }
    }
private:
    AscendC::TPipe pipe_;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> input_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> output_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> aBuffer_, bBuffer_, tempBuffer_,
        productBuffer_, indexBuffer_, partBuffer_, maxBuffer_;
    AscendC::GlobalTensor<T> aGm_, bGm_;
    AscendC::GlobalTensor<float> yGm_;
    uint32_t batches_, m_, n_, k_, aCount_, bCount_, inputOffset_, nPad_, groups_;
};

template <typename T, bool TA, bool TB>
__global__ __vector__ void bmmms_small_kernel(GM_ADDR a, GM_ADDR b, GM_ADDR y,
    uint32_t batches, uint32_t m, uint32_t n, uint32_t k) {
    BmmmsSmallKernel<T, TA, TB> op;
    op.Init(a, b, y, batches, m, n, k);
    op.Process();
}

template <typename T>
inline void LaunchSmall(GM_ADDR a, GM_ADDR b, GM_ADDR y, aclrtStream stream,
    uint32_t blocks, uint32_t batches, uint32_t m, uint32_t n, uint32_t k, bool ta, bool tb) {
    if (ta) {
        if (tb) bmmms_small_kernel<T, true, true><<<blocks, nullptr, stream>>>(a, b, y, batches, m, n, k);
        else bmmms_small_kernel<T, true, false><<<blocks, nullptr, stream>>>(a, b, y, batches, m, n, k);
    } else {
        if (tb) bmmms_small_kernel<T, false, true><<<blocks, nullptr, stream>>>(a, b, y, batches, m, n, k);
        else bmmms_small_kernel<T, false, false><<<blocks, nullptr, stream>>>(a, b, y, batches, m, n, k);
    }
}

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
    GM_ADDR x2, const TensorGroupInfo& info_x2, GM_ADDR y, const TensorGroupInfo& info_y,
    int64_t availableCoreNum, aclrtStream stream, bool transposeX1, bool transposeX2) {
    using namespace bmmms;
    if (info_x1.numTensors != 1 || info_x2.numTensors != 1 || info_y.numTensors != 1) return;
    const TensorInfo& a = info_x1.tensors[0];
    const TensorInfo& b = info_x2.tensors[0];
    const TensorInfo& out = info_y.tensors[0];
    if (a.numDims != 3 || b.numDims != 3 || out.numDims != 1) return;
    if ((a.dtype != 1 && a.dtype != 2) || a.dtype != b.dtype || out.dtype != 0) return;
    const int64_t B = a.shape[0], M = a.shape[transposeX1 ? 2 : 1];
    const int64_t K = a.shape[transposeX1 ? 1 : 2], N = b.shape[transposeX2 ? 1 : 2];
    if (B < 1 || B > 64 || M < 1 || M > 8192 || N < 1 || N > 8192 ||
        K < 32 || K > 8192 || K % 8 != 0) return;
    if (B != b.shape[0] || K != b.shape[transposeX2 ? 2 : 1] || out.shape[0] != B) return;
    if (B * M * K > (int64_t(1) << 26) || B * N * K > (int64_t(1) << 26)) return;
    if (availableCoreNum <= 0 || availableCoreNum > 1024) return;
    if (M == 1 && N == 1) {
        const uint32_t blocks = std::min(B, 2 * availableCoreNum);
        if (a.dtype == 1) bmmms_dot_kernel<half><<<blocks, nullptr, stream>>>(x1, x2, y, B, K);
        else bmmms_dot_kernel<bfloat16_t><<<blocks, nullptr, stream>>>(x1, x2, y, B, K);
        return;
    }
    if (M <= 32 && N <= 64 && K <= 256 && N * K <= 8192 && M * N * K <= 65536) {
        const uint32_t blocks = std::min(B, 2 * availableCoreNum);
        if (a.dtype == 1) LaunchSmall<half>(x1, x2, y, stream, blocks, B, M, N, K,
                                         transposeX1, transposeX2);
        else LaunchSmall<bfloat16_t>(x1, x2, y, stream, blocks, B, M, N, K,
                                    transposeX1, transposeX2);
        return;
    }
    aclrtContext context = nullptr;
    if (aclrtGetCurrentContext(&context) != ACL_SUCCESS) return;
    static thread_local std::vector<Plan> plans;
    Plan* selected = nullptr;
    for (auto& plan : plans) {
        if (plan.context == context && plan.b == B && plan.m == M && plan.n == N && plan.k == K &&
            plan.cores == availableCoreNum && plan.dtype == a.dtype &&
            plan.ta == transposeX1 && plan.tb == transposeX2) { selected = &plan; break; }
    }
    if (selected == nullptr) {
        Plan plan{};
        if (!MakePlan(context, B, M, N, K, availableCoreNum, a.dtype, transposeX1, transposeX2, plan))
            return;
        plans.push_back(plan);
        selected = &plans.back();
    }
    GM_ADDR workspace = (GM_ADDR)GetScratch(context, stream,
        selected->systemBytes + selected->tileBytes + selected->partialBytes);
    if (workspace == nullptr) return;
    if (a.dtype == 1) Dispatch<half>(x1, x2, y, stream, *selected, workspace);
    else Dispatch<bfloat16_t>(x1, x2, y, stream, *selected, workspace);
}

// Optional standalone lifecycle hook: call before destroying/resetting context.
extern "C" void batch_matmul_max_sum_release(aclrtStream stream) {
    using namespace bmmms;
    aclrtContext context = nullptr;
    if (aclrtGetCurrentContext(&context) != ACL_SUCCESS) return;
    auto& cache = ScratchCache();
    for (auto it = cache.begin(); it != cache.end();) {
        if (it->context == context && it->stream == stream) {
            if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) return;
            if (aclrtFree(it->address) != ACL_SUCCESS) return;
            it = cache.erase(it);
        } else { ++it; }
    }
}
