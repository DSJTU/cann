#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cmath>
#include <array>
#include <algorithm>
#include <chrono>
#include <fstream>
#include <stdexcept>
#include <string>
#include <vector>
#include <dlfcn.h>
#include "acl/acl.h"

struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
#ifdef BMMMS_TRACE_RUNTIME
static size_t scratchAllocations = 0, scratchFrees = 0;
static aclError internalRuntimeError = ACL_SUCCESS;
static aclError TraceMalloc(void** ptr, size_t bytes, aclrtMemMallocPolicy policy)
{
    const auto ret = aclrtMalloc(ptr, bytes, policy);
    if (ret == ACL_SUCCESS) ++scratchAllocations;
    else internalRuntimeError = ret;
    std::fprintf(stderr, "INTERNAL_ALLOC ret=%d bytes=%zu\n", int(ret), bytes);
    return ret;
}
static aclError TraceFree(void* ptr)
{
    const auto ret = aclrtFree(ptr);
    if (ret == ACL_SUCCESS) ++scratchFrees;
    else internalRuntimeError = ret;
    std::fprintf(stderr, "INTERNAL_FREE ret=%d\n", int(ret));
    return ret;
}
static aclError TraceSync(aclrtStream stream, int32_t timeout)
{
    const auto status = aclrtSynchronizeStreamWithTimeout(stream, timeout);
    if (status != ACL_SUCCESS) internalRuntimeError = status;
    std::fprintf(stderr, "INTERNAL_SYNC ret=%d\n", int(status));
    std::fflush(stderr);
    return status;
}
static aclError TraceRegister(aclmdlRI model, aclrtCallback callback, void* data)
{
    const auto ret = aclmdlRIDestroyRegisterCallback(model, callback, data);
    if (ret != ACL_SUCCESS) internalRuntimeError = ret;
    std::fprintf(stderr, "INTERNAL_REGISTER ret=%d\n", int(ret));
    return ret;
}
#define aclrtSynchronizeStreamWithTimeout TraceSync
#define aclrtMalloc TraceMalloc
#define aclrtFree TraceFree
#define aclmdlRIDestroyRegisterCallback TraceRegister
#endif
#ifdef BMMMS_LOAD_SHARED_TEST
#define GM_ADDR uint8_t*
using RunKernel = void (*)(GM_ADDR, const TensorGroupInfo&, GM_ADDR,
    const TensorGroupInfo&, GM_ADDR, const TensorGroupInfo&, int64_t,
    aclrtStream, bool, bool);
static RunKernel run_kernel = nullptr;
#else
#include "../kernel.asc"
#endif
#ifdef BMMMS_TRACE_RUNTIME
#undef aclrtSynchronizeStreamWithTimeout
#undef aclrtMalloc
#undef aclrtFree
#undef aclmdlRIDestroyRegisterCallback
#endif

static void Check(aclError status, const char* operation)
{
    if (status != ACL_SUCCESS)
        throw std::runtime_error(std::string(operation) + " ret=" + std::to_string(status));
}
struct DeviceBuffer {
    uint8_t* ptr = nullptr;
    explicit DeviceBuffer(size_t bytes)
    {
        Check(aclrtMalloc(reinterpret_cast<void**>(&ptr), bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc");
    }
    ~DeviceBuffer() { if (ptr) aclrtFree(ptr); }
    DeviceBuffer(const DeviceBuffer&) = delete;
    DeviceBuffer& operator=(const DeviceBuffer&) = delete;
};
static void Read(std::ifstream& input, void* data, size_t bytes)
{
    input.read(static_cast<char*>(data), bytes);
    if (!input) throw std::runtime_error("truncated input");
}
int main(int argc, char** argv)
{
    if (argc != 3 && (argc != 4 || (std::strcmp(argv[3], "--capture") &&
        std::strcmp(argv[3], "--capture-chain") && std::strcmp(argv[3], "--capture-cold")))) {
        std::fprintf(stderr, "Usage: %s input.bin output.bin [--capture|--capture-chain|--capture-cold]\n", argv[0]);
        return 1;
    }
    const bool capture = argc == 4;
    const uint32_t captureCalls = capture && !std::strcmp(argv[3], "--capture-chain") ? 3 : 1;
    const bool warmCapture = !capture || std::strcmp(argv[3], "--capture-cold");
    aclrtStream stream = nullptr;
    aclmdlRI model = nullptr;
    bool initialized = false, deviceSet = false;
    void* loadedLibrary = nullptr;
    try {
#ifdef BMMMS_LOAD_SHARED_TEST
        const char* path = std::getenv("BMMMS_SHARED_LIBRARY");
        if (!path) throw std::runtime_error("BMMMS_SHARED_LIBRARY is required");
        loadedLibrary = dlopen(path, RTLD_NOW | RTLD_LOCAL);
        if (!loadedLibrary) throw std::runtime_error(dlerror());
        run_kernel = reinterpret_cast<RunKernel>(dlsym(loadedLibrary, "run_kernel"));
        if (!run_kernel) throw std::runtime_error("missing run_kernel export");
        std::fprintf(stderr, "SHARED_DISPATCH library=%s\n", path);
#endif
        std::ifstream input(argv[1], std::ios::binary);
        std::ofstream output(argv[2], std::ios::binary);
        if (!input || !output) throw std::runtime_error("cannot open input/output");
        Check(aclInit(nullptr), "aclInit");
        initialized = true;
        Check(aclrtSetDevice(0), "aclrtSetDevice");
        deviceSet = true;
        Check(aclrtCreateStream(&stream), "aclrtCreateStream");
        int64_t availableCores = 0;
        Check(aclrtGetDeviceInfo(0, ACL_DEV_ATTR_CUBE_CORE_NUM, &availableCores), "aclrtGetDeviceInfo");
        if (availableCores < 1) throw std::runtime_error("no available cores");
        std::fprintf(stderr, "Device: %s, availableCoreNum=%lld\n", aclrtGetSocName(), (long long)availableCores);
        uint32_t count;
        Read(input, &count, sizeof(count));
        for (uint32_t ci = 0; ci < count; ++ci) {
            std::array<uint32_t, 9> h;
            Read(input, h.data(), sizeof(h));
            const uint32_t batch = h[0], m = h[1], n = h[2], k = h[3], dtype = h[4];
            const bool ta = h[5], tb = h[6];
            const int64_t cores = h[7] ? std::min<int64_t>(h[7], availableCores) : availableCores;
            if (!batch || batch > 64 || !m || m > 8192 || !n || n > 8192 ||
                k < 32 || k > 8192 || k % 8 || (dtype != 1 && dtype != 2) ||
                uint64_t(batch) * m * k > (1u << 26) || uint64_t(batch) * n * k > (1u << 26))
                throw std::runtime_error("invalid test dimensions");
            std::vector<uint16_t> a(size_t(batch) * m * k), b(size_t(batch) * n * k);
            Read(input, a.data(), a.size() * sizeof(uint16_t));
            Read(input, b.data(), b.size() * sizeof(uint16_t));
            DeviceBuffer da(a.size() * sizeof(uint16_t)), db(b.size() * sizeof(uint16_t));
            std::vector<float> y(batch + 16, -987654.0f);
            DeviceBuffer dy(y.size() * sizeof(float));
            Check(aclrtMemcpy(da.ptr, a.size() * 2, a.data(), a.size() * 2, ACL_MEMCPY_HOST_TO_DEVICE), "copy x1");
            Check(aclrtMemcpy(db.ptr, b.size() * 2, b.data(), b.size() * 2, ACL_MEMCPY_HOST_TO_DEVICE), "copy x2");
            int64_t as[] = {batch, ta ? k : m, ta ? m : k};
            int64_t bs[] = {batch, tb ? n : k, tb ? k : n};
            int64_t ys[] = {batch};
            TensorInfo ai = {as, 3, int32_t(dtype)}, bi = {bs, 3, int32_t(dtype)}, yi = {ys, 1, 0};
            TensorGroupInfo ag = {&ai, 1}, bg = {&bi, 1}, yg = {&yi, 1};
            if (capture) {
                if (warmCapture) {
                    run_kernel((GM_ADDR)da.ptr, ag, (GM_ADDR)db.ptr, bg, (GM_ADDR)dy.ptr, yg, cores, stream, ta, tb);
                    Check(aclrtSynchronizeStreamWithTimeout(stream, 3000), "warmup sync");
                }
                Check(aclmdlRICaptureBegin(stream, ACL_MODEL_RI_CAPTURE_MODE_GLOBAL), "capture begin");
                for (uint32_t capturedCall = 0; capturedCall < captureCalls; ++capturedCall)
                    run_kernel((GM_ADDR)da.ptr, ag, (GM_ADDR)db.ptr, bg, (GM_ADDR)dy.ptr, yg, cores, stream, ta, tb);
                Check(aclmdlRICaptureEnd(stream, &model), "capture end");
                std::fprintf(stderr, "CAPTURE_OK case=%u\n", ci);
            }
            std::vector<float> first;
            for (uint32_t repeat = 0; repeat < 2; ++repeat) {
                std::fill(y.begin(), y.end(), -987654.0f);
                Check(aclrtMemcpy(dy.ptr, y.size() * 4, y.data(), y.size() * 4, ACL_MEMCPY_HOST_TO_DEVICE), "initialize output guards");
                const auto begin = std::chrono::steady_clock::now();
                if (capture) Check(aclmdlRIExecuteAsync(model, stream), "capture replay");
                else run_kernel((GM_ADDR)da.ptr, ag, (GM_ADDR)db.ptr, bg, (GM_ADDR)dy.ptr, yg, cores, stream, ta, tb);
                Check(aclrtSynchronizeStreamWithTimeout(stream, 3000), "kernel sync");
                const double us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - begin).count();
                Check(aclrtMemcpy(y.data(), y.size() * 4, dy.ptr, y.size() * 4, ACL_MEMCPY_DEVICE_TO_HOST), "read output");
                for (uint32_t j = 0; j < batch; ++j)
                    if (!std::isfinite(y[j])) throw std::runtime_error("nonfinite output");
                for (uint32_t j = batch; j < y.size(); ++j)
                    if (y[j] != -987654.0f) throw std::runtime_error("output guard changed");
                if (repeat == 0) first = y;
                else if (std::memcmp(first.data(), y.data(), y.size() * sizeof(float)))
                    throw std::runtime_error("nondeterministic output");
                std::fprintf(stderr, "CASE %u repeat=%u B=%u M=%u N=%u K=%u dtype=%u ta=%u tb=%u cores=%lld wall_us=%.3f\n",
                    ci, repeat, batch, m, n, k, dtype, unsigned(ta), unsigned(tb), (long long)cores, us);
                std::fflush(stderr);
            }
            if (model) {
                Check(aclmdlRIDestroy(model), "destroy capture");
                model = nullptr;
            }
            std::vector<uint16_t> afterA(a.size()), afterB(b.size());
            Check(aclrtMemcpy(afterA.data(), a.size() * 2, da.ptr, a.size() * 2, ACL_MEMCPY_DEVICE_TO_HOST), "read x1 guard");
            Check(aclrtMemcpy(afterB.data(), b.size() * 2, db.ptr, b.size() * 2, ACL_MEMCPY_DEVICE_TO_HOST), "read x2 guard");
            if (a != afterA || b != afterB) throw std::runtime_error("input mutation");
            output.write(reinterpret_cast<const char*>(y.data()), batch * sizeof(float));
            output.flush();
            if (!output) throw std::runtime_error("cannot write output");
        }
        Check(aclrtDestroyStream(stream), "aclrtDestroyStream");
        stream = nullptr;
        if (loadedLibrary) {
            if (dlclose(loadedLibrary)) throw std::runtime_error("dlclose failed");
            loadedLibrary = nullptr;
        }
        Check(aclrtResetDevice(0), "aclrtResetDevice");
        deviceSet = false;
        Check(aclFinalize(), "aclFinalize");
        initialized = false;
#ifdef BMMMS_TRACE_RUNTIME
        std::fprintf(stderr, "INTERNAL_SUMMARY allocations=%zu frees=%zu error=%d\n",
            scratchAllocations, scratchFrees, int(internalRuntimeError));
        if (scratchAllocations != scratchFrees || internalRuntimeError != ACL_SUCCESS)
            return 3;
#endif
        return 0;
    } catch (const std::exception& e) {
        std::fprintf(stderr, "NPU test failed: %s\n", e.what());
        if (model) aclmdlRIDestroy(model);
        if (stream) aclrtDestroyStream(stream);
        if (loadedLibrary) dlclose(loadedLibrary);
        if (deviceSet) aclrtResetDevice(0);
        if (initialized) aclFinalize();
        return 2;
    }
}
