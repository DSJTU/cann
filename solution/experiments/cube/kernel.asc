// Isolated capture-lifecycle candidate; target validation is still required.
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include <stdexcept>
#include <cstdio>
#include <map>
#include <memory>
#include <mutex>
#include <vector>

namespace cube_probe {
constexpr uint32_t rows = 32, columns = 64;
template <AscendC::HardEvent event> __aicore__ inline void Fence(AscendC::TPipe &pipe) {
    const auto id = pipe.FetchEventID(event);
    AscendC::SetFlag<event>(id);
    AscendC::WaitFlag<event>(id);
}
template <typename T>
__global__ __mix__(1, 2) void Scores(GM_ADDR x1, GM_ADDR x2, GM_ADDR rowMax,
    __kfc_workspace__ GM_ADDR workspace, AscendC::tiling::TCubeTiling tiling,
    uint32_t batch, uint32_t m, uint32_t n, uint32_t k, bool ta, bool tb) {
    AscendC::TPipe pipe;
    matmul::Matmul<
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, true>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, T, true>,
        matmul::MatmulType<AscendC::TPosition::VECIN, CubeFormat::ND, float>,
        matmul::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, float>> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    AscendC::GlobalTensor<T> a, b;
    AscendC::GlobalTensor<float> maxima;
    a.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x1), batch * m * k);
    b.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(x2), batch * n * k);
    maxima.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(rowMax), batch * m);
    AscendC::TBuf<AscendC::TPosition::VECIN> cBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> partialBuf, maxBuf, rowBuf, offsetsBuf;
    AscendC::TBuf<AscendC::TPosition::VECOUT> packedBuf;
    pipe.InitBuffer(cBuf, rows * columns * sizeof(float));
    pipe.InitBuffer(partialBuf, rows * 8 * sizeof(float));
    pipe.InitBuffer(maxBuf, rows * 8 * sizeof(float));
    pipe.InitBuffer(rowBuf, columns * sizeof(float));
    pipe.InitBuffer(offsetsBuf, columns * sizeof(uint32_t));
    pipe.InitBuffer(packedBuf, rows * sizeof(float));
    auto c = cBuf.Get<float>();
    auto partial = partialBuf.Get<float>();
    auto maximum = maxBuf.Get<float>();
    auto packed = packedBuf.Get<float>();
    auto oneRow = rowBuf.Get<float>();
    auto offsets = offsetsBuf.Get<uint32_t>();
    for (uint32_t col = 0; col < columns; ++col) offsets.SetValue(col, col * sizeof(float));
    Fence<AscendC::HardEvent::S_V>(pipe);
    AscendC::Duplicate(partial, 0.0f, rows * 8);
    AscendC::PipeBarrier<PIPE_V>();
    const uint32_t mTiles = (m + rows - 1) / rows;
    // __mix__(1, 2) launches two AIV workers per logical block.
    const uint32_t vectorWorkers = 2 * AscendC::GetBlockNum();
    for (uint32_t task = AscendC::GetBlockIdx(); task < batch * mTiles; task += vectorWorkers) {
        const uint32_t bi = task / mTiles, m0 = task % mTiles * rows;
        const uint32_t validM = m - m0 < rows ? m - m0 : rows;
        for (uint32_t n0 = 0; n0 < n; n0 += columns) {
            const uint32_t validN = n - n0 < columns ? n - n0 : columns;
            mm.SetOrgShape(m, n, k);
            mm.SetSingleShape(validM, validN, k);
            mm.SetTensorA(a[bi * m * k + (ta ? m0 : m0 * k)], ta);
            mm.SetTensorB(b[bi * n * k + (tb ? n0 * k : n0)], tb);
            while (mm.template Iterate<true>()) {
                mm.template GetTensorC<true>(c, 0, true);
                // Sequential ND output is packed with the actual tail width.
                // An unaligned row start cannot be expressed as a repeat stride.
                if (validN % 8 == 0) {
                    AscendC::WholeReduceMax(partial, c, int32_t(validN), int32_t(validM), 8, 1,
                        validN / 8, AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                } else {
                    for (uint32_t row = 0; row < validM; ++row) {
                        AscendC::Gather(oneRow, c, offsets, row * validN * sizeof(float), validN);
                        AscendC::PipeBarrier<PIPE_V>();
                        AscendC::WholeReduceMax(partial[row * 8], oneRow, int32_t(validN), 1, 8, 1,
                            columns / 8, AscendC::ReduceOrder::ORDER_ONLY_VALUE);
                        AscendC::PipeBarrier<PIPE_V>();
                    }
                }
                AscendC::PipeBarrier<PIPE_V>();
                if (n0 == 0) AscendC::DataCopy(maximum, partial, validM * 8);
                else AscendC::Max(maximum, maximum, partial, validM * 8);
                AscendC::PipeBarrier<PIPE_V>();
                // Finish the Vector consumers before Scalar ends this Matmul
                // context or requests another output into the same UB buffer.
                Fence<AscendC::HardEvent::V_S>(pipe);
            }
            mm.End();
        }
        Fence<AscendC::HardEvent::V_S>(pipe);
        for (uint32_t row = 0; row < validM; ++row) packed.SetValue(row, maximum.GetValue(row * 8));
        Fence<AscendC::HardEvent::S_MTE3>(pipe);
        AscendC::DataCopyExtParams cp = {1, validM * uint32_t(sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(maxima[bi * m + m0], packed, cp);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}

__global__ __mix__(0, 1) void Finish(GM_ADDR rowMax, GM_ADDR y, uint32_t batch, uint32_t m) {
    AscendC::TPipe pipe;
    AscendC::GlobalTensor<float> maxima, output;
    maxima.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(rowMax), batch * m);
    output.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), batch);
    AscendC::TBuf<AscendC::TPosition::VECIN> inBuf;
    AscendC::TBuf<AscendC::TPosition::VECOUT> outBuf;
    pipe.InitBuffer(inBuf, rows * sizeof(float));
    pipe.InitBuffer(outBuf, 32);
    auto values = inBuf.Get<float>(), result = outBuf.Get<float>();
    for (uint32_t bi = AscendC::GetBlockIdx(); bi < batch; bi += AscendC::GetBlockNum()) {
        float total = 0.0f, correction = 0.0f;
        for (uint32_t m0 = 0; m0 < m; m0 += rows) {
            const uint32_t count = m - m0 < rows ? m - m0 : rows;
            AscendC::DataCopyExtParams cp = {1, count * uint32_t(sizeof(float)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<float> pad = {false, 0, 0, 0};
            AscendC::DataCopyPad(values, maxima[bi * m + m0], cp, pad);
            Fence<AscendC::HardEvent::MTE2_S>(pipe);
            for (uint32_t row = 0; row < count; ++row) {
                const float term = values.GetValue(row) - correction;
                const float next = total + term;
                correction = (next - total) - term;
                total = next;
            }
            Fence<AscendC::HardEvent::S_MTE2>(pipe);
        }
        result.SetValue(0, total);
        Fence<AscendC::HardEvent::S_MTE3>(pipe);
        AscendC::DataCopyExtParams cp = {1, uint32_t(sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPad(output[bi], result, cp);
        AscendC::PipeBarrier<PIPE_ALL>();
    }
}
inline void Check(aclError status) {
    if (status != ACL_SUCCESS) throw std::runtime_error("Cube probe ACL failure: " + std::to_string(status));
}
// A model owns every captured invocation's buffers through its single callback.
// Keeping one state per model also supports multiple calls in the same graph.
struct Scratch { void *workspace; void *maxima; };
struct CapturedScratch {
    aclmdlRI model;
    std::vector<Scratch> calls;
};
inline std::mutex &ScratchMutex() { static std::mutex mutex; return mutex; }
inline std::map<aclmdlRI, std::unique_ptr<CapturedScratch>> &ScratchModels() {
    static std::map<aclmdlRI, std::unique_ptr<CapturedScratch>> models;
    return models;
}
inline void ReleaseCaptured(void *data) {
    auto *state = static_cast<CapturedScratch *>(data);
    std::unique_ptr<CapturedScratch> owned;
    {
        std::lock_guard<std::mutex> lock(ScratchMutex());
        auto &models = ScratchModels();
        const auto it = models.find(state->model);
        if (it == models.end() || it->second.get() != state) {
            std::fprintf(stderr, "Cube capture cleanup state mismatch\n");
            return;
        }
        owned = std::move(it->second);
        models.erase(it);
    }
    // Callback cannot throw through the runtime. Trace mode independently checks
    // these return codes and allocation/free counts in the validation runner.
    for (const auto &call : owned->calls) {
        const auto rowStatus = aclrtFree(call.maxima);
        const auto workStatus = aclrtFree(call.workspace);
        if (rowStatus != ACL_SUCCESS || workStatus != ACL_SUCCESS)
            std::fprintf(stderr, "Cube capture cleanup failed: rows=%d workspace=%d\n",
                int(rowStatus), int(workStatus));
    }
}
inline void RetainCaptured(aclmdlRI model, Scratch scratch) {
    std::lock_guard<std::mutex> lock(ScratchMutex());
    auto &models = ScratchModels();
    const auto old = models.find(model);
    if (old != models.end()) {
        old->second->calls.push_back(scratch);
        return;
    }
    std::unique_ptr<CapturedScratch> state(new CapturedScratch{model, {scratch}});
    auto *data = state.get();
    const auto inserted = models.emplace(model, std::move(state));
    const auto registered = aclmdlRIDestroyRegisterCallback(model, ReleaseCaptured, data);
    if (registered != ACL_SUCCESS) {
        models.erase(inserted.first);
        Check(registered);
    }
}
} // namespace cube_probe

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo &info_x1, GM_ADDR x2,
    const TensorGroupInfo &info_x2, GM_ADDR y, const TensorGroupInfo &, int64_t availableCoreNum,
    aclrtStream stream, bool ta, bool tb) {
    using namespace cube_probe;
    const auto &a = info_x1.tensors[0], &b = info_x2.tensors[0];
    const uint32_t batch = a.shape[0], m = a.shape[ta ? 2 : 1];
    const uint32_t k = a.shape[ta ? 1 : 2], n = b.shape[tb ? 1 : 2];
    if (k > 128) throw std::runtime_error("Cube probe currently requires K <= 128");
    auto *platform = platform_ascendc::PlatformAscendCManager::GetInstance("Ascend910_9362");
    if (!platform) throw std::runtime_error("Cube probe platform unavailable");
    matmul_tiling::MatmulApiTiling api(*platform);
    using P = matmul_tiling::TPosition;
    using F = matmul_tiling::CubeFormat;
    using D = matmul_tiling::DataType;
    const auto dtype = a.dtype == 1 ? D::DT_FLOAT16 : D::DT_BF16;
    api.SetAType(P::GM, F::ND, dtype, ta);
    api.SetBType(P::GM, F::ND, dtype, tb);
    api.SetCType(P::LCM, F::ND, D::DT_FLOAT);
    api.SetShape(rows, columns, k);
    api.SetOrgShape(m, n, k);
    api.SetBias(false);
    api.SetFixSplit(rows, columns, -1);
    api.SetBufferSpace(-1, -1, -1);
    AscendC::tiling::TCubeTiling tiling;
    if (api.GetTiling(tiling) == -1 || tiling.baseM != rows || tiling.baseN != columns)
        throw std::runtime_error("Cube probe tiling rejected fixed tile");
    const size_t workspaceBytes = platform->GetLibApiWorkSpaceSize();
    if (workspaceBytes == UINT32_MAX || !workspaceBytes) throw std::runtime_error("Invalid Cube workspace size");
    aclmdlRICaptureStatus captureStatus = ACL_MODEL_RI_CAPTURE_STATUS_NONE;
    aclmdlRI model = nullptr;
    Check(aclmdlRICaptureGetInfo(stream, &captureStatus, &model));
    if (captureStatus != ACL_MODEL_RI_CAPTURE_STATUS_NONE &&
        (captureStatus != ACL_MODEL_RI_CAPTURE_STATUS_ACTIVE || !model))
        throw std::runtime_error("Invalid Cube stream capture state");
    const bool captured = captureStatus == ACL_MODEL_RI_CAPTURE_STATUS_ACTIVE;
    void *workspace = nullptr, *maxima = nullptr;
    Check(aclrtMalloc(&workspace, workspaceBytes, ACL_MEM_MALLOC_HUGE_FIRST));
    const auto allocated = aclrtMalloc(&maxima, size_t(batch) * m * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    if (allocated != ACL_SUCCESS) { Check(aclrtFree(workspace)); Check(allocated); }
    if (captured) {
        try { RetainCaptured(model, {workspace, maxima}); }
        catch (...) {
            const auto rowStatus = aclrtFree(maxima), workStatus = aclrtFree(workspace);
            Check(rowStatus); Check(workStatus);
            throw;
        }
    }
    const uint32_t cores = availableCoreNum > 0 ? uint32_t(availableCoreNum) : 20;
    const uint32_t tasks = batch * ((m + rows - 1) / rows);
    const uint32_t blocks = (tasks + 1) / 2 < cores ? (tasks + 1) / 2 : cores;
    if (a.dtype == 1)
        Scores<half><<<blocks, nullptr, stream>>>(x1, x2, (GM_ADDR)maxima, (GM_ADDR)workspace, tiling, batch, m, n, k, ta, tb);
    else
        Scores<bfloat16_t><<<blocks, nullptr, stream>>>(x1, x2, (GM_ADDR)maxima, (GM_ADDR)workspace, tiling, batch, m, n, k, ta, tb);
    Finish<<<batch < cores ? batch : cores, nullptr, stream>>>((GM_ADDR)maxima, y, batch, m);
    // Captured tasks execute only on replay; the model callback owns their buffers.
    if (captured) return;
    // Ordinary calls retain buffers until stream completion. A failed sync leaves
    // them alive for caller recovery, rather than freeing potentially live memory.
    const auto sync = aclrtSynchronizeStreamWithTimeout(stream, 60000);
    Check(sync);
    const auto freeMax = aclrtFree(maxima), freeWork = aclrtFree(workspace);
    Check(freeMax); Check(freeWork);
}
